---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteSettings } from '../../config/site';
import { getPlanches, parSaison, plancheCode, planchePath } from '../../lib/bd';

const planches = await getPlanches();
const recentes = [...planches].sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime() || planches.indexOf(b) - planches.indexOf(a)
);
const saisons = parSaison(recentes);
const derniere = recentes[0];
const premiere = planches[0];
const formatDate = (date: Date) => date.toLocaleDateString('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'BD', item: `${siteSettings.siteUrl}/bd/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Les BD d’Octet',
  itemListElement: planches.map((planche, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(planchePath(planche), siteSettings.siteUrl).toString(),
    name: planche.data.title,
  })),
};
---

<SiteLayout
  title="Les BD d’Octet : le numérique en une planche | Le Singe Du Numérique"
  description="Chaque lundi, une nouvelle BD d’Octet pour comprendre le numérique et la cybersécurité sans jargon. Retrouvez la dernière planche et tous les épisodes."
  eyebrow="Le rendez-vous du lundi"
  headline="Les BD"
  accent="d’Octet"
  intro="Chaque lundi, une nouvelle BD pour comprendre le numérique avec humour."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  {planches.length === 0 ? (
    <p class="bd-empty">Les premières planches arrivent très bientôt.</p>
  ) : (
    <>
      {derniere && (
        <section class="bd-latest" aria-labelledby="bd-latest-title">
          <a class="bd-latest-preview" href={planchePath(derniere)} aria-label={`Lire la dernière BD : ${derniere.data.title}`}>
            <img src={derniere.data.planche} alt="" width={derniere.data.plancheWidth} height={derniere.data.plancheHeight} fetchpriority="high" decoding="async" />
          </a>
          <div class="bd-latest-body">
            <p class="bd-kicker">La dernière BD · {plancheCode(derniere, true)}</p>
            <time datetime={derniere.data.pubDate.toISOString()}>Parue le {formatDate(derniere.data.pubDate)}</time>
            <h2 id="bd-latest-title">{derniere.data.title}</h2>
            <p>{derniere.data.description}</p>
            <a href={planchePath(derniere)} class="cta-button cta-primary">Lire la dernière BD →</a>
            {premiere && <a class="bd-start" href={planchePath(premiere)}>Découvrir la série depuis le début</a>}
          </div>
        </section>
      )}

      <section class="bd-archives" aria-labelledby="bd-archives-title">
        <div class="bd-archives-heading">
          <div>
            <p class="bd-kicker">À explorer à votre rythme</p>
            <h2 id="bd-archives-title">Toutes les BD <span class="bd-count">({planches.length})</span></h2>
          </div>
          <a href="/bd.xml" class="bd-subscribe">Suivre les BD par RSS →</a>
        </div>
        <p class="bd-archives-intro">Retrouvez les aventures d’Octet. Chaque planche dispose d’une transcription intégrale.</p>
        <div class="bd-controls" hidden>
          <label>Saison
            <select id="bd-season-filter">
              <option value="all">Toutes les saisons</option>
              {saisons.map(({ saison }) => <option value={saison}>Saison {saison}</option>)}
            </select>
          </label>
          <label>Afficher
            <select id="bd-sort">
              <option value="recent">Les plus récentes d’abord</option>
              <option value="reading">Dans l’ordre de lecture</option>
            </select>
          </label>
          <p id="bd-results" role="status" aria-live="polite">{planches.length} BD</p>
        </div>
        <ul class="bd-grid" role="list">
          {recentes.map((planche) => (
            <li class="bd-card" data-season={planche.data.saison} data-reading={planches.indexOf(planche)} data-recent={recentes.indexOf(planche)}>
              <a href={planchePath(planche)} class="bd-card-link">
                <img src={planche.data.planche} alt="" width={planche.data.plancheWidth} height={planche.data.plancheHeight} loading="lazy" decoding="async" class="bd-card-thumb" />
                <span class="bd-card-body">
                  <span class="bd-chip">{plancheCode(planche, true)}{planche === derniere ? ' · Dernière BD' : ''}</span>
                  <span class="bd-card-title">{planche.data.title}</span>
                  <time class="bd-card-date" datetime={planche.data.pubDate.toISOString()}>{formatDate(planche.data.pubDate)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </>
  )}

  <p class="bd-rss">
    <a href="/bd.xml">S’abonner au flux RSS des BD</a>
  </p>
</SiteLayout>

<script>
  const controls = document.querySelector<HTMLElement>('.bd-controls');
  const season = document.querySelector<HTMLSelectElement>('#bd-season-filter');
  const sort = document.querySelector<HTMLSelectElement>('#bd-sort');
  const grid = document.querySelector<HTMLElement>('.bd-grid');
  const results = document.querySelector<HTMLElement>('#bd-results');
  if (controls && season && sort && grid && results) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.bd-card'));
    const update = () => {
      const key = sort.value === 'reading' ? 'reading' : 'recent';
      cards.sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]));
      let count = 0;
      for (const card of cards) {
        card.hidden = season.value !== 'all' && card.dataset.season !== season.value;
        if (!card.hidden) count++;
        grid.append(card);
      }
      results.textContent = `${count} BD`;
    };
    controls.hidden = false;
    season.addEventListener('change', update);
    sort.addEventListener('change', update);
  }
</script>

<style>
  .bd-empty { padding: 32px; border: 1px dashed var(--border); border-radius: 16px; text-align: center; color: var(--text-muted); }
  .bd-latest { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 64px; border: 1px solid var(--border); border-radius: 24px; overflow: hidden; background: var(--bg-card); }
  .bd-latest-preview { display: block; background: var(--code-bg); padding: 24px; }
  .bd-latest-preview img { display: block; width: 100%; height: 360px; object-fit: contain; object-position: center; }
  .bd-latest-body { padding: 36px; align-self: center; }
  .bd-kicker { margin: 0 0 12px; font-size: .85rem; font-weight: 700; color: var(--accent); }
  .bd-latest time, .bd-card-date { color: var(--text-muted); font-size: .85rem; }
  .bd-latest h2 { margin: 16px 0; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; }
  .bd-latest-body > p:not(.bd-kicker) { margin: 0 0 24px; color: var(--text-muted); }
  .bd-latest .cta-button { text-decoration: none; }
  .bd-start { display: block; width: fit-content; margin-top: 20px; color: var(--text-muted); text-underline-offset: 4px; }
  .bd-archives-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .bd-archives h2 { margin: 0; font-size: 1.75rem; }
  .bd-count { color: var(--text-muted); font-size: 1rem; font-weight: 400; }
  .bd-subscribe, .bd-rss a { color: var(--accent); text-underline-offset: 4px; }
  .bd-archives-intro { color: var(--text-muted); margin: 16px 0 24px; }
  .bd-controls { display: flex; align-items: end; gap: 20px; flex-wrap: wrap; padding: 20px; margin-bottom: 24px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; }
  .bd-controls[hidden], .bd-card[hidden] { display: none; }
  .bd-controls label { display: grid; gap: 8px; font-size: .85rem; font-weight: 700; }
  .bd-controls select { max-width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-card); color: var(--text-main, inherit); font: inherit; }
  #bd-results { margin: 0 0 10px auto; color: var(--text-muted); font-size: .85rem; }
  .bd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .bd-card { border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--bg-card); transition: transform .2s ease, border-color .2s ease; }
  .bd-card:hover, .bd-card:focus-within { transform: translateY(-3px); border-color: var(--accent); }
  .bd-card-link { display: block; height: 100%; color: inherit; text-decoration: none; }
  .bd-card-thumb { display: block; width: 100%; height: 150px; object-fit: cover; object-position: top center; background: var(--code-bg); }
  .bd-card-body { display: block; padding: 16px; }
  .bd-chip { display: inline-block; margin-bottom: 10px; color: var(--accent); font-size: .75rem; font-weight: 700; }
  .bd-card-title { display: block; margin-bottom: 12px; font-size: 1.05rem; font-weight: 700; line-height: 1.35; }
  .bd-card-date { display: block; }
  .bd-rss { margin-top: 40px; text-align: center; }
  a:focus-visible, select:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 640px) {
    .bd-latest { grid-template-columns: 1fr; margin-bottom: 40px; }
    .bd-latest-preview { padding: 16px; }
    .bd-latest-preview img { height: 280px; }
    .bd-latest-body { padding: 24px; }
    .bd-controls { gap: 16px; }
    .bd-controls label { width: 100%; }
    #bd-results { margin: 0; }
    .bd-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bd-card { transition: none; }
    .bd-card:hover, .bd-card:focus-within { transform: none; }
  }
</style>
