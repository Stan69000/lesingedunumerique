---
import { render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { siteSettings } from '../../../config/site';
import { getPlanches, plancheCode, planchePath } from '../../../lib/bd';

export async function getStaticPaths() {
  const planches = await getPlanches();
  return planches.map((planche, index) => ({
    params: { bd: planche.id },
    props: {
      precedente: planches[index - 1] ?? null,
      suivante: planches[index + 1] ?? null,
    },
  }));
}

const { bd } = Astro.params;
const { precedente, suivante } = Astro.props;

const planches = await getPlanches();
const planche = planches.find((entry) => entry.id === bd);

if (!planche) {
  return new Response('Not Found', { status: 404 });
}

const { Content } = await render(planche);
const code = plancheCode(planche);
const canonicalUrl = new URL(planchePath(planche), siteSettings.siteUrl).toString();
const pageTitle = `${planche.data.title} (${code}) | Les BD d’Octet`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ComicStory',
  name: planche.data.title,
  description: planche.data.description,
  datePublished: planche.data.pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: planche.data.author || siteSettings.siteName,
  },
  publisher: {
    '@type': 'Organization',
    name: siteSettings.siteName,
    logo: {
      '@type': 'ImageObject',
      url: `${siteSettings.siteUrl}/logo.svg`,
    },
  },
  image: new URL(planche.data.planche, siteSettings.siteUrl).toString(),
  mainEntityOfPage: canonicalUrl,
  inLanguage: 'fr-FR',
};
---

<SiteLayout
  title={pageTitle}
  description={planche.data.description}
  eyebrow={`BD — ${code}`}
  headline={planche.data.title}
  intro={planche.data.description}
  image={planche.data.planche}
  shareTitle={`${planche.data.title} — Les BD d’Octet`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />

  <p class="bd-back"><a href="/bd/">← Toutes les planches</a></p>

  <figure class="bd-figure">
    <img
      src={planche.data.planche}
      alt={planche.data.plancheAlt}
      width={planche.data.plancheWidth}
      height={planche.data.plancheHeight}
      decoding="async"
      class="bd-planche"
    />
    <figcaption>
      <time datetime={planche.data.pubDate.toISOString()}>
        Publiée le {planche.data.pubDate.toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })}
      </time>
      <a href={planche.data.planche} class="bd-fullsize">Voir la planche en grand</a>
    </figcaption>
  </figure>

  {planche.data.tags.length > 0 && (
    <ul class="bd-tags" role="list" aria-label="Thèmes abordés">
      {planche.data.tags.map((tag) => <li class="bd-tag">{tag}</li>)}
    </ul>
  )}

  <section class="bd-transcription" aria-labelledby="bd-transcription-title">
    <h2 id="bd-transcription-title">Transcription</h2>
    <Content />
  </section>

  <nav class="bd-nav" aria-label="Navigation entre les planches">
    {precedente ? (
      <a href={planchePath(precedente)} class="bd-nav-link bd-nav-prev">
        <span class="bd-nav-label">Planche précédente</span>
        <span class="bd-nav-title">{plancheCode(precedente)} — {precedente.data.title}</span>
      </a>
    ) : <span></span>}
    {suivante && (
      <a href={planchePath(suivante)} class="bd-nav-link bd-nav-next">
        <span class="bd-nav-label">Planche suivante</span>
        <span class="bd-nav-title">{plancheCode(suivante)} — {suivante.data.title}</span>
      </a>
    )}
  </nav>
</SiteLayout>

<style>
  .bd-back {
    margin: 0 0 24px;
  }

  .bd-back a {
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
  }

  .bd-figure {
    margin: 0 0 32px;
  }

  .bd-planche {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--bg-card);
  }

  .bd-figure figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    justify-content: space-between;
    margin-top: 12px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }

  .bd-fullsize {
    color: var(--accent);
    text-decoration: underline;
  }

  .bd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }

  .bd-tag {
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .bd-transcription {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--bg-card);
  }

  .bd-transcription h2 {
    margin-top: 0;
  }

  .bd-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }

  /* Le reset des liens du layout est scopé : il ne descend pas dans le slot. */
  .bd-nav-link {
    display: block;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
  }

  .bd-nav-link:hover {
    border-color: var(--accent);
  }

  .bd-nav-next {
    grid-column: 2;
    text-align: right;
  }

  .bd-nav-label {
    display: block;
    margin-bottom: 6px;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bd-nav-title {
    display: block;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .bd-nav {
      grid-template-columns: 1fr;
    }

    .bd-nav-next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
