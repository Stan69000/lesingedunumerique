---
import SiteLayout from '../layouts/SiteLayout.astro';

const rssFeeds = [
  {
    title: 'Articles et guides',
    description: 'Tous les nouveaux articles et guides.',
    href: '/blog.xml',
  },
  {
    title: 'Les BD d’Octet',
    description: 'Une nouvelle planche de BD chaque semaine.',
    href: '/bd.xml',
  },
  {
    title: 'Toutes les alertes',
    description: 'Arnaques, fuites de données et actualité réunies dans un seul flux.',
    href: '/veille.xml',
  },
  {
    title: 'Alertes : dernières arnaques',
    description: 'Les arnaques et campagnes frauduleuses repérées.',
    href: '/veille-arnaques.xml',
  },
  {
    title: 'Alertes : dernières fuites de données',
    description: 'Les fuites de données et failles de sécurité signalées.',
    href: '/veille-failles.xml',
  },
  {
    title: 'Actualité générale',
    description: 'L’actualité de la cybersécurité et des associations.',
    href: '/veille-actu-generaliste.xml',
  },
];
---

<SiteLayout
  title="Flux RSS | Le Singe Du Numérique"
  description="S’abonner aux articles, aux BD et aux alertes arnaques du Singe Du Numérique par flux RSS."
  eyebrow="Flux RSS"
  headline="Suivre le site"
  accent="par flux RSS"
  intro="Un flux RSS vous prévient à chaque nouvelle publication, sans compte et sans passer par les réseaux sociaux. Choisissez un ou plusieurs flux ci-dessous."
  showShare={false}
>
  <section class="flux-grid">
    {
      rssFeeds.map((feed) => (
        <article class="flux-card">
          <h2>{feed.title}</h2>
          <p>{feed.description}</p>
          <div class="flux-actions">
            <a href={feed.href}>Ouvrir le flux</a>
            <button type="button" data-copy={feed.href}>Copier l’adresse</button>
          </div>
        </article>
      ))
    }
  </section>

  <p class="flux-help">
    Astuce : collez l’adresse du flux dans votre lecteur RSS préféré (Inoreader, Feedly, NetNewsWire, Thunderbird…).
  </p>

  <script>
    const copyButtons = Array.from(document.querySelectorAll('button[data-copy]'));
    copyButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const href = button.getAttribute('data-copy');
        if (!href) return;
        const absoluteUrl = new URL(href, window.location.origin).toString();
        await navigator.clipboard.writeText(absoluteUrl);
        const previous = button.textContent;
        button.textContent = 'Copié';
        window.setTimeout(() => {
          button.textContent = previous;
        }, 1200);
      });
    });
  </script>
</SiteLayout>

<style>
  .flux-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .flux-card {
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--bg-card);
    padding: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .flux-card h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .flux-card p {
    margin: 0;
    color: var(--text-muted);
  }

  .flux-actions {
    display: inline-flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .flux-actions a,
  .flux-actions button {
    border: 1px solid var(--border-color);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-main);
    background: transparent;
    padding: 0.45rem 0.8rem;
    font: inherit;
    cursor: pointer;
  }

  .flux-actions a:hover,
  .flux-actions button:hover {
    border-color: var(--brand-green);
    color: var(--brand-green);
  }

  .flux-help {
    margin: 1.3rem 0 0;
    color: var(--text-muted);
  }
</style>
