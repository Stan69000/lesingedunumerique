---
import SiteLayout from '../layouts/SiteLayout.astro';
import { lexique } from '../lib/lexique';
import LexiqueExplorer from '../components/LexiqueExplorer.astro';

const entrees = [...lexique].sort((a, b) => a.terme.localeCompare(b.terme, 'fr'));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Le lexique d’Octet',
  hasDefinedTerm: entrees.map((entree) => ({
    '@type': 'DefinedTerm',
    name: entree.terme,
    description: entree.definition,
  })),
};
---

<SiteLayout
  title="Le lexique d’Octet : les mots du numérique en clair | Le Singe Du Numérique"
  description="Le lexique d’Octet : des mots du numérique expliqués avec des situations du quotidien, des réflexes utiles et des liens vers nos articles, BD et outils, avec les univers SEO/GEO, RGAA, arnaques et jargon IA."
  eyebrow="Comprendre, à votre rythme"
  headline="Le lexique"
  accent="d’Octet"
  intro="Un SMS de livraison douteux, des photos qui disparaissent, une appli trop curieuse… Octet part de votre quotidien pour mettre des mots sur ce qui se passe. De MCP aux faux colis, des titres HTML au clavier : piochez les mots qui vous sont utiles, sans avoir à tout connaître."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <aside class="octet-intro"><strong>🐒 « Les mots compliqués, on les débrouille ensemble. »</strong><p>Pour chaque mot : une explication, une situation qui vous parle et un réflexe à emporter. Vous pouvez aussi chercher « colis », « photos » ou « association ».</p></aside>

  <aside class="octet-intro"><strong>🐒 Choisissez les mots dont vous avez besoin.</strong><p>Un seul lexique, plusieurs portes d’entrée : <a href="/lexique/?univers=numerique">numérique au quotidien</a>, <a href="/lexique/?univers=seo">SEO et GEO</a> <a href="/lexique/?univers=accessibilite">accessibilité et RGAA</a>, <a href="/lexique/?univers=arnaques">arnaques et manipulation</a> ou <a href="/lexique/?univers=jargon">IA et jargon technique</a>. Les filtres se combinent avec la recherche et les thèmes. Un mot peut appartenir à plusieurs univers sans être dupliqué.</p></aside>
  <aside class="octet-intro"><strong>Comprendre les arnaques sans culpabiliser.</strong><p>Les situations décrites aident à repérer des signaux, pas à diagnostiquer avec certitude chaque message. Certains intitulés de manipulation sont pédagogiques : une urgence ou une demande de confidentialité ne prouvent pas seules une fraude. Si cela vous arrive, <a href="https://17cyber.gouv.fr/">17Cyber peut vous orienter</a>. Les fiches renvoient aux conseils officiels adaptés.</p></aside>
  <LexiqueExplorer entries={lexique} searchPlaceholder="Un mot ou une situation : MCP, faux colis, code SMS, H1…" />

  <aside class="lexique-sources"><h2>Pour aller à la source</h2><p>Octet explique avec ses mots. Pour approfondir : <a href="https://www.cnil.fr/fr/definition">le vocabulaire de la CNIL</a> (vie privée et IA), <a href="https://www.cnil.fr/fr/definition/cookie">sa définition des cookies</a> et <a href="https://www.cybermalveillance.gouv.fr/tous-nos-contenus/bonnes-pratiques/10-mesures-essentielles-assurer-securite-numerique">les conseils de Cybermalveillance.gouv.fr</a> (comptes, sauvegardes et sécurité). Pour l’accessibilité : <a href="https://accessibilite.numerique.gouv.fr/">le RGAA officiel</a> et <a href="https://www.w3.org/WAI/">les ressources W3C WAI</a>. Les démarches et les services évoluent : les pages officielles restent le point de référence.</p></aside>

</SiteLayout>

<style>
.octet-intro,.lexique-sources{padding:1.25rem;border:1px solid var(--border-color);border-radius:16px;margin-bottom:1.5rem;background:var(--bg-card);line-height:1.7}
.octet-intro strong{color:var(--text-main);font-size:1.15rem}.octet-intro p{margin-bottom:0}.lexique-sources{margin-top:2rem}.octet-intro a,.lexique-sources a{color:var(--brand-green);text-decoration:underline}
</style>
