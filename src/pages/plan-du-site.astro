---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getJeux, jeuxDisponibles, urlJeu } from '../lib/jeux';

const jeux = jeuxDisponibles(await getJeux());
---

<SiteLayout
  title="Plan du site | Le Singe Du Numérique"
  description="Plan du site du Singe Du Numérique pour accéder rapidement aux principales pages et rubriques."
  eyebrow="Navigation"
  headline="Plan"
  accent="du site"
  intro="Retrouve ici les principales pages du site, avec des accès directs vers les contenus utiles."
>
  <section class="prose-block">
    <h2>Pages principales</h2>
    <ul>
      <li><a href="/">Accueil</a></li>
      <li><a href="/projets">Projets</a></li>
      <li><a href="/sensibilisation">Sensibilisation</a></li>
      <li><a href="/asso">L’association</a></li>
      <li><a href="/adhesion">Rejoindre</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/blog">Blog</a></li>
    </ul>
  </section>

  <section class="prose-block">
    <h2>Sensibilisation</h2>
    <ul>
      <li><a href="/sensibilisation">Ressources de sensibilisation</a></li>
      <li><a href="/sensibilisation/jeux">Catalogue des jeux</a></li>
      {jeux.map((jeu) => <li><a href={urlJeu(jeu)}>{jeu.data.titre}</a></li>)}
    </ul>
  </section>

  <section class="prose-block">
    <h2>Informations légales et accessibilité</h2>
    <ul>
      <li><a href="/accessibilite">Accessibilité</a></li>
      <li><a href="/mentions-legales">Mentions légales</a></li>
    </ul>
  </section>
</SiteLayout>
