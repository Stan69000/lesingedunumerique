---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://lesingedunumerique.fr/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sensibilisation',
      item: 'https://lesingedunumerique.fr/sensibilisation/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Jeux de sensibilisation',
      item: 'https://lesingedunumerique.fr/sensibilisation/jeux/',
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: 'SENTINEL',
      item: 'https://lesingedunumerique.fr/sensibilisation/jeux/sentinel/',
    },
  ],
};
---

<SiteLayout
  title="SENTINEL: jeu cybersécurité et simulation immersive | Le Singe Du Numerique"
  description="SENTINEL est un jeu de cybersécurité gratuit: enquêtes, terminal, scénarios et décisions sous pression pour apprendre les réflexes de défense numérique."
  eyebrow="Sensibilisation"
  headline="SENTINEL"
  accent="simulation immersive"
  intro="Un jeu de cybersécurité en trois modes pour enqueter, decider et progresser comme un agent."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="game-host" aria-labelledby="sentinel-title">
    <article class="game-intro-card reveal reveal-0">
      <div class="game-top-row">
        <p class="game-badge">Ado et adultes</p>
        <a href="/sensibilisation/jeux" class="mini-link">Voir tous les jeux</a>
      </div>
      <h2 id="sentinel-title">Jouer pour entraîner les réflexes cyber</h2>
      <p>
        SENTINEL vous place dans des situations de défense numérique réalistes: analyse, priorisation,
        decision rapide et consequences sur la mission.
      </p>
      <ul class="risk-tags" aria-label="Thèmes SENTINEL">
        <li>Mails suspects</li>
        <li>Mots de passe</li>
        <li>Deepfakes</li>
        <li>Securite reseau</li>
        <li>Gestion de crise</li>
      </ul>
      <div class="cta-row">
        <a href="#jouer-maintenant" class="cta-button cta-primary">Jouer maintenant</a>
        <a href="/jeux/sentinel.html" class="cta-button cta-secondary" target="_blank" rel="noopener noreferrer">
          Ouvrir en plein écran
        </a>
      </div>
    </article>

    <div id="jouer-maintenant" class="frame-shell reveal reveal-1">
      <iframe
        src="/jeux/sentinel.html"
        title="Jeu SENTINEL"
        loading="lazy"
        class="game-frame"
        allow="fullscréén"
      ></iframe>
    </div>

    <article class="game-description reveal reveal-2">
      <p><strong>Devenez agent. Montez en grade. Defendez le numérique.</strong></p>
      <h2>Simulation cybersécurité pour s'entraîner</h2>
      <p>
        SENTINEL est un jeu de simulation cybersécurité créé par Le Singe du Numerique. Vous incarnez un agent
        en formation au sein d'une agence fictive et vous progressez à travers trois modes complémentaires.
      </p>
      <p>
        Mode Arcade: quatre mini-jeux pour tester vos réflexes. Classifiez de vrais emails (légitimes ou
        phishing ?), construisez le mot de passe le plus solide possible, bloquez des attaques reseau en temps
        réel, débusquez les deepfakes parmi de vrais contenus.
      </p>
      <p>
        Mode Terminal: un vrai faux terminal de commandes. Analysez un poste compromis, remontez une fuite de
        données, gérez un ransomware en cours de propagation.
      </p>
      <p>
        Mode Aventure: des operations scénarisées avec dialogues, choix et consequences réelles. Chaque
        mauvaise decision coute de la crédibilité.
      </p>
      <p>
        Votre progression est sauvegardée: XP, grades (de Recrue à Sentinel), badges, journal des operations.
      </p>
      <p><strong>Jouer · Sans inscription · Sans publicité · Sans données collectées</strong></p>
      <p>
        Pour découvrir nos autres ressources, retournez vers la
        <a href="/sensibilisation/jeux"> bibliothèque de jeux de sensibilisation</a>.
      </p>
    </article>
  </section>
</SiteLayout>

<style>
  :global(.game-host) {
    display: grid;
    gap: 16px;
  }

  :global(.game-intro-card),
  :global(.frame-shell),
  :global(.game-description) {
    position: relative;
    border: 1px solid rgba(144, 177, 222, 0.24);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(18, 30, 60, 0.9), rgba(10, 18, 40, 0.94));
    overflow: hidden;
  }

  :global(.game-intro-card),
  :global(.game-description) {
    padding: clamp(1rem, 2.2vw, 1.55rem);
  }

  :global(.game-intro-card::before),
  :global(.frame-shell::before) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(95, 232, 255, 0.08), transparent 46%);
    pointer-events: none;
  }

  :global(.game-top-row) {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  :global(.game-badge) {
    margin: 0;
    border: 1px solid rgba(86, 226, 241, 0.35);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(187, 245, 253, 0.95);
    background: rgba(36, 91, 136, 0.28);
  }

  :global(.mini-link) {
    font-size: 0.9rem;
  }

  :global(.risk-tags) {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  :global(.risk-tags li) {
    border-radius: 999px;
    border: 1px solid rgba(119, 145, 184, 0.45);
    background: rgba(13, 29, 56, 0.66);
    color: rgba(212, 226, 245, 0.94);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 4px 9px;
  }

  :global(.cta-row) {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  :global(.cta-row .cta-button) {
    text-align: center;
    justify-content: center;
    text-decoration: none;
  }

  :global(.frame-shell) {
    padding: 8px;
  }

  :global(.game-frame) {
    width: 100%;
    height: min(1280px, calc(100vh - 180px));
    min-height: 840px;
    border: 0;
    border-radius: 14px;
    background: #fff;
  }

  :global(.game-description p:last-child) {
    margin-bottom: 0;
  }

  :global(.reveal) {
    opacity: 0;
    transform: translateY(8px);
    animation: revealIn 0.62s ease forwards;
  }

  :global(.reveal-0) { animation-delay: 0.03s; }
  :global(.reveal-1) { animation-delay: 0.08s; }
  :global(.reveal-2) { animation-delay: 0.14s; }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @medià (prefers-reduced-motion: reduce) {
    :global(.reveal) {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @medià (max-width: 720px) {
    :global(.game-frame) {
      height: 86vh;
      min-height: 680px;
    }

    :global(.game-intro-card),
    :global(.frame-shell),
    :global(.game-description) {
      border-radius: 16px;
    }
  }
</style>
