---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import GameCard from '../../../components/GameCard.astro';
import { getJeux, jeuxDisponibles, publicsCouverts, themesCouverts, urlJeu } from '../../../lib/jeux';
import { siteSettings } from '../../../config/site';
import '../../../styles/jeux.css';

const jeux = await getJeux();
const disponibles = jeuxDisponibles(jeux);
const aVenir = jeux.filter((jeu) => jeu.data.statut === 'bientot');
const publics = publicsCouverts(jeux);
const themes = themesCouverts(jeux);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/` },
    { '@type': 'ListItem', position: 3, name: 'Jeux de sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/jeux/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Jeux de sensibilisation numérique',
  itemListElement: disponibles.map((jeu, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteSettings.siteUrl}${urlJeu(jeu)}`,
    name: jeu.data.titre,
  })),
};
---

<SiteLayout
  title="Jeux de sensibilisation numérique et cybersécurité | Le Singe Du Numerique"
  description="Catalogue des jeux pédagogiques gratuits du Singe du Numérique: filtrez par public et par thème pour trouver le jeu adapté à votre atelier ou à votre famille."
  eyebrow="Sensibilisation"
  headline="Catalogue"
  accent="des jeux"
  intro="Tous nos jeux de sensibilisation au numérique et à la cybersécurité, filtrables par public et par thème."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="hub">
    <section class="hub-card reveal reveal-0" aria-labelledby="catalogue-titre">
      <p class="hub-kicker">Catalogue complet</p>
      <h2 id="catalogue-titre">Trouver le jeu adapté à votre public</h2>
      <p>
        Chaque jeu se joue directement dans le navigateur, sans inscription et sans collecte de données.
        Utilisez les filtres pour cibler un âge ou un sujet précis.
      </p>
      <ul class="hub-stats">
        <li><strong>{disponibles.length}</strong> {disponibles.length > 1 ? 'jeux jouables' : 'jeu jouable'}</li>
        <li><strong>{themes.length}</strong> thèmes couverts</li>
        <li><strong>{aVenir.length}</strong> {aVenir.length > 1 ? 'jeux en préparation' : 'jeu en préparation'}</li>
      </ul>
    </section>

    <section aria-labelledby="filtres-titre">
      <h2 id="filtres-titre" class="sr-only">Filtrer les jeux</h2>

      <div class="filters" id="filtres" hidden>
        <fieldset class="filter-group" data-facette="publics">
          <legend>Public</legend>
          {
            publics.map((cible) => (
              <button type="button" class="filter-chip" aria-pressed="false" data-valeur={cible.toLowerCase()}>
                {cible}
              </button>
            ))
          }
        </fieldset>

        <fieldset class="filter-group" data-facette="themes">
          <legend>Thème</legend>
          {
            themes.map((theme) => (
              <button type="button" class="filter-chip" aria-pressed="false" data-valeur={theme.toLowerCase()}>
                {theme}
              </button>
            ))
          }
        </fieldset>

        <div class="filters-footer">
          <p class="filters-status" id="filtres-statut" role="status">
            {jeux.length} {jeux.length > 1 ? 'jeux affichés' : 'jeu affiché'}
          </p>
          <button type="button" class="filter-chip" data-reinitialiser hidden>Tout afficher</button>
        </div>
      </div>
    </section>

    <div class="games-grid" role="list" aria-label="Liste des jeux">
      {jeux.map((jeu) => <GameCard jeu={jeu} niveauTitre="h2" />)}
    </div>

    <p class="filters-empty" id="filtres-vide" hidden>
      Aucun jeu ne correspond à cette combinaison de filtres.
      <button type="button" class="filter-chip" data-reinitialiser>Réinitialiser les filtres</button>
    </p>

    <div class="hub-bottom">
      <section class="game-panel reveal reveal-2" aria-labelledby="pour-qui-titre">
        <h2 id="pour-qui-titre">Pour qui sont ces jeux ?</h2>
        <p><strong>Tout le monde.</strong> Aucune base technique n'est nécessaire pour jouer.</p>
        <ul>
          <li>Familles et adolescents, pour lancer la discussion à la maison.</li>
          <li>Associations et médiateurs numériques, en intervention terrain.</li>
          <li>Animateurs d'ateliers et structures éducatives.</li>
          <li>Et n'importe qui d'autre, curieux comme déjà à l'aise.</li>
        </ul>
      </section>

      <section class="game-panel reveal reveal-3" aria-labelledby="atelier-titre">
        <h2 id="atelier-titre">Besoin d'un atelier sur mesure ?</h2>
        <p>
          Contactez-nous pour organiser une session adaptée à votre public: niveau, contexte terrain et
          objectifs pédagogiques.
        </p>
        <p><a href="/contact">Nous contacter</a></p>
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .hub-bottom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
</style>

<script>
  const barre = document.getElementById('filtres');
  const statut = document.getElementById('filtres-statut');
  const messageVide = document.getElementById('filtres-vide');
  const cartes = Array.from(document.querySelectorAll<HTMLElement>('[data-jeu]'));

  if (barre && statut && cartes.length > 0) {
    barre.hidden = false;

    const chips = Array.from(barre.querySelectorAll<HTMLButtonElement>('[data-facette] .filter-chip'));

    const selection = (facette: string) =>
      chips
        .filter((chip) => chip.closest('[data-facette]')?.getAttribute('data-facette') === facette)
        .filter((chip) => chip.getAttribute('aria-pressed') === 'true')
        .map((chip) => chip.dataset.valeur ?? '');

    const correspond = (carte: HTMLElement, facette: string, valeurs: string[]) => {
      if (valeurs.length === 0) return true;
      const contenu = (carte.dataset[facette] ?? '').split('|');
      return valeurs.some((valeur) => contenu.includes(valeur));
    };

    const boutonsReset = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-reinitialiser]'));

    const appliquer = () => {
      const publics = selection('publics');
      const themes = selection('themes');
      let visibles = 0;

      cartes.forEach((carte) => {
        const garde = correspond(carte, 'publics', publics) && correspond(carte, 'themes', themes);
        carte.hidden = !garde;
        if (garde) visibles += 1;
      });

      const filtreActif = publics.length + themes.length > 0;
      statut.textContent = filtreActif
        ? `${visibles} ${visibles > 1 ? 'jeux affichés' : 'jeu affiché'} sur ${cartes.length}`
        : `${cartes.length} ${cartes.length > 1 ? 'jeux affichés' : 'jeu affiché'}`;
      if (messageVide) messageVide.hidden = visibles > 0;
      boutonsReset.forEach((bouton) => {
        if (!bouton.closest('#filtres-vide')) bouton.hidden = !filtreActif;
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        appliquer();
      });
    });

    boutonsReset.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        chips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
        appliquer();
        chips[0]?.focus();
      });
    });

    appliquer();
  }
</script>
