---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import GameCard from '../../../components/GameCard.astro';
import { jeux, facetteUtile, optionsUtilisees, nombreDeThemes, type Facette } from '../../../lib/jeux';
import { siteSettings } from '../../../config/site';
import '../../../styles/jeux.css';

const nbThemes = nombreDeThemes();

// Facettes dans l'ordre des questions qu'on se pose : pour qui, comment, quoi, combien de temps.
const FACETTES: Array<{ id: Facette; legende: string }> = [
  { id: 'public', legende: 'Pour qui' },
  { id: 'format', legende: 'Comment jouer' },
  { id: 'theme', legende: 'Thème' },
  { id: 'duree', legende: 'Durée' },
];
const facettes = FACETTES.filter((f) => facetteUtile(f.id)).map((f) => ({ ...f, options: optionsUtilisees(f.id) }));
// Recherche et tri n'ont d'intérêt qu'à partir de quelques jeux.
const avecOutils = jeux.length >= 4;
const avecTriRecent = jeux.some((j) => j.publishedAt);
const avecTriDuree = jeux.some((j) => j.duration);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/` },
    { '@type': 'ListItem', position: 3, name: 'Jeux de sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/jeux/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Jeux de sensibilisation numérique',
  itemListElement: jeux.map((jeu, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteSettings.siteUrl}/sensibilisation/jeux/${jeu.slug}/`,
    name: jeu.name,
  })),
};
---

<SiteLayout
  title="Jeux de sensibilisation numérique et cybersécurité | Le Singe Du Numérique"
  description="Le catalogue complet des jeux pédagogiques gratuits du Singe du Numérique: phishing, cyberharcèlement, réseaux sociaux, intelligence artificielle et protection des données."
  eyebrow="Jeux"
  headline="Catalogue"
  accent="des jeux"
  intro="Tous nos jeux de sensibilisation au numérique et à la cybersécurité, à jouer en famille, en atelier ou en classe."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="hub">
    <section class="hub-card reveal reveal-0" aria-labelledby="catalogue-titre">
      <p class="hub-kicker">Catalogue complet</p>
      <h2 id="catalogue-titre">Trouver le jeu adapté à votre public</h2>
      <p>
        Chaque jeu se joue directement dans le navigateur, sans inscription et sans collecte de données.
        Choisissez votre public, votre façon de jouer ou un thème : la liste se met à jour.
      </p>
      <ul class="hub-stats">
        <li><strong>{jeux.length}</strong> {jeux.length > 1 ? 'jeux disponibles' : 'jeu disponible'}</li>
        <li><strong>{nbThemes}</strong> {nbThemes > 1 ? 'thèmes abordés' : 'thème abordé'}</li>
        <li><strong>100%</strong> gratuit</li>
      </ul>
    </section>

    {
      avecOutils && (
        <section aria-labelledby="filtres-titre">
          <h2 id="filtres-titre" class="sr-only">Filtrer les jeux</h2>

          <div class="filters" id="filtres" hidden>
            <div class="filters-toolbar">
              <div class="filters-field">
                <label for="filtre-recherche">Rechercher</label>
                <input id="filtre-recherche" type="search" placeholder="arnaque, mot de passe, IA…" autocomplete="off" />
              </div>
              <div class="filters-field is-sort">
                <label for="filtre-tri">Trier</label>
                <select id="filtre-tri">
                  <option value="">Ordre conseillé</option>
                  {avecTriRecent && <option value="recent">Les plus récents</option>}
                  {avecTriDuree && <option value="duree">Les plus courts</option>}
                </select>
              </div>
            </div>

            {facettes.length > 0 && (
              <details class="filters-more" id="filtres-plus" open>
                <summary class="filter-chip">
                  Filtres <span id="filtres-actifs"></span>
                </summary>
              <div class="filters-facets">
                {facettes.map((f) => (
                  <fieldset class="filter-group" data-facette={f.id}>
                    <legend>{f.legende}</legend>
                    {f.options.map((o) => (
                      <button
                        type="button"
                        class="filter-chip"
                        aria-pressed="false"
                        data-valeur={o.key}
                        title={o.hint || undefined}
                      >
                        {o.label}
                      </button>
                    ))}
                  </fieldset>
                ))}
              </div>
              </details>
            )}

            <div class="filters-footer">
              <p class="filters-status" id="filtres-statut" role="status">
                {jeux.length} {jeux.length > 1 ? 'jeux affichés' : 'jeu affiché'}
              </p>
              <button type="button" class="filter-chip" data-reinitialiser hidden>Tout afficher</button>
            </div>
          </div>
        </section>
      )
    }

    <div id="jouer-maintenant" class="games-grid" role="list" aria-label="Liste des jeux">
      {jeux.map((jeu, index) => <GameCard jeu={jeu} index={index} ordre={index} />)}
    </div>

    {
      avecOutils && (
        <p class="filters-empty" id="filtres-vide" hidden>
          Aucun jeu ne correspond à cette sélection.
          <button type="button" class="filter-chip" data-reinitialiser>Tout afficher</button>
        </p>
      )
    }

    <div class="hub-bottom-grid">
      <section class="hub-panel reveal reveal-2" aria-labelledby="pour-qui-titre">
        <h2 id="pour-qui-titre">Pour qui sont ces jeux ?</h2>
        <p><strong>Tout le monde.</strong> Aucune base technique n'est nécessaire pour jouer.</p>
        <ul>
          <li>Familles et adolescents, pour lancer la discussion à la maison.</li>
          <li>Associations et médiateurs numériques, en intervention terrain.</li>
          <li>Animateurs d'ateliers et structures éducatives.</li>
          <li>Et n'importe qui d'autre, curieux comme déjà à l'aise.</li>
        </ul>
      </section>

      <section class="hub-panel reveal reveal-3" aria-labelledby="atelier-titre">
        <h2 id="atelier-titre">Un projet autour de ces jeux ?</h2>
        <p>
          Nous ne proposons pas d'ateliers pour le moment, mais nous pouvons en parler sur rendez-vous :
          public visé, contexte et objectifs pédagogiques.
        </p>
        <p><a href="/contact/">Nous contacter</a></p>
      </section>
    </div>
  </div>
</SiteLayout>

<script>
  const barre = document.getElementById('filtres');
  const statut = document.getElementById('filtres-statut');
  const messageVide = document.getElementById('filtres-vide');
  const grille = document.getElementById('jouer-maintenant');
  const recherche = document.getElementById('filtre-recherche') as HTMLInputElement | null;
  const tri = document.getElementById('filtre-tri') as HTMLSelectElement | null;
  const cartes = Array.from(document.querySelectorAll<HTMLElement>('[data-jeu]'));

  // Même normalisation que data-recherche (GameCard) : minuscules, sans accents.
  const normaliser = (texte: string) =>
    texte.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

  if (barre && statut && grille && cartes.length > 0) {
    barre.hidden = false;

    const groupes = Array.from(barre.querySelectorAll<HTMLFieldSetElement>('[data-facette]'));
    const chips = groupes.flatMap((g) => Array.from(g.querySelectorAll<HTMLButtonElement>('.filter-chip')));
    const boutonsReset = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-reinitialiser]'));

    /** Sélection par facette : OU à l'intérieur d'une facette, ET entre facettes. */
    const selection = () =>
      groupes
        .map((g) => ({
          facette: g.dataset.facette ?? '',
          valeurs: Array.from(g.querySelectorAll<HTMLButtonElement>('.filter-chip'))
            .filter((c) => c.getAttribute('aria-pressed') === 'true')
            .map((c) => c.dataset.valeur ?? ''),
        }))
        .filter((s) => s.valeurs.length > 0);

    // Sur mobile, les filtres replient leur liste (dépliée si l'adresse en sélectionne déjà).
    const plus = document.getElementById('filtres-plus') as HTMLDetailsElement | null;
    const actifs = document.getElementById('filtres-actifs');
    const mobile = window.matchMedia('(max-width: 720px)');
    const ajusterRepli = () => {
      if (plus) plus.open = !mobile.matches || selection().length > 0;
    };
    mobile.addEventListener('change', ajusterRepli);

    const trier = () => {
      const mode = tri?.value ?? '';
      const cle = (c: HTMLElement) => Number(c.dataset.ordre ?? 0);
      const ordonnees = [...cartes].sort((a, b) => {
        if (mode === 'recent') {
          return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '') || cle(a) - cle(b);
        }
        if (mode === 'duree') {
          return Number(a.dataset.rangDuree ?? 9) - Number(b.dataset.rangDuree ?? 9) || cle(a) - cle(b);
        }
        return cle(a) - cle(b);
      });
      ordonnees.forEach((carte) => grille.appendChild(carte));
    };

    /** Garde la sélection dans l'adresse : un lien ouvre une sélection toute faite. */
    const memoriser = (choix: ReturnType<typeof selection>, texte: string) => {
      const params = new URLSearchParams();
      choix.forEach((s) => params.set(s.facette, s.valeurs.join(',')));
      if (texte) params.set('q', texte);
      if (tri?.value) params.set('tri', tri.value);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    const appliquer = () => {
      const choix = selection();
      const texte = recherche?.value.trim() ?? '';
      const mots = normaliser(texte).split(/\s+/).filter(Boolean);
      let visibles = 0;

      cartes.forEach((carte) => {
        const garde =
          choix.every((s) => {
            const portees = (carte.dataset[s.facette] ?? '').split(' ');
            return s.valeurs.some((v) => portees.includes(v));
          }) && mots.every((mot) => (carte.dataset.recherche ?? '').includes(mot));
        carte.hidden = !garde;
        if (garde) visibles += 1;
      });

      const filtre = choix.length > 0 || mots.length > 0;
      const nbChoix = choix.reduce((n, s) => n + s.valeurs.length, 0);
      if (actifs) actifs.textContent = nbChoix ? `(${nbChoix})` : '';
      statut.textContent = filtre
        ? `${visibles} ${visibles > 1 ? 'jeux affichés' : 'jeu affiché'} sur ${cartes.length}`
        : `${cartes.length} ${cartes.length > 1 ? 'jeux affichés' : 'jeu affiché'}`;
      if (messageVide) messageVide.hidden = visibles > 0;
      boutonsReset.forEach((bouton) => {
        if (!bouton.closest('#filtres-vide')) bouton.hidden = !filtre;
      });
      memoriser(choix, texte);
    };

    // État initial depuis l'adresse (?public=seniors&theme=arnaques,comptes&q=…&tri=recent).
    const params = new URLSearchParams(location.search);
    groupes.forEach((g) => {
      const voulues = (params.get(g.dataset.facette ?? '') ?? '').split(',').filter(Boolean);
      g.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((c) => {
        c.setAttribute('aria-pressed', voulues.includes(c.dataset.valeur ?? '') ? 'true' : 'false');
      });
    });
    if (recherche) recherche.value = params.get('q') ?? '';
    if (tri && [...tri.options].some((o) => o.value === params.get('tri'))) tri.value = params.get('tri') ?? '';

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        appliquer();
      });
    });
    recherche?.addEventListener('input', appliquer);
    tri?.addEventListener('change', () => {
      trier();
      appliquer();
    });

    boutonsReset.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        chips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
        if (recherche) recherche.value = '';
        appliquer();
        (recherche ?? chips[0])?.focus();
      });
    });

    trier();
    appliquer();
    ajusterRepli();
  }
</script>
