---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import GameCard from '../../../components/GameCard.astro';
import { jeux } from '../../../lib/jeux';
import { siteSettings } from '../../../config/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/` },
    { '@type': 'ListItem', position: 3, name: 'Jeux de sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/jeux/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Jeux de sensibilisation numérique',
  itemListElement: jeux.map((jeu, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteSettings.siteUrl}/sensibilisation/jeux/${jeu.slug}/`,
    name: jeu.name,
  })),
};

const themeCount = new Set(jeux.flatMap((jeu) => jeu.tags.map((tag) => tag.toLowerCase()))).size;
---

<SiteLayout
  title="Jeux de sensibilisation numérique et cybersécurité | Le Singe Du Numerique"
  description="Découvrez des jeux pédagogiques gratuits pour sensibiliser enfants, adolescents et adultes aux risques numériques: phishing, cyberharcèlement, réseaux sociaux et protection des données."
  eyebrow="Sensibilisation"
  headline="Nos jeux"
  accent="pédagogiques"
  intro="Jeux gratuits de sensibilisation au numérique et à la cybersécurité, utilisés en famille, en atelier et en milieu associatif."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="games-hub" aria-labelledby="games-hub-title">
    <div class="hub-intro-card reveal reveal-0">
      <p class="hub-kicker">Bibliothèque active</p>
      <h2 id="games-hub-title">Jouer pour ancrer les bons réflexes</h2>
      <p>
        Cette bibliothèque rassemble nos jeux de prévention numérique pour s'entraîner face aux arnaques,
        au cyberharcèlement, à la désinformation et aux attaques en ligne.
      </p>
      <div class="hub-stats" aria-label="Aperçu des jeux disponibles">
        <p><strong>{jeux.length}</strong> {jeux.length > 1 ? 'jeux disponibles' : 'jeu disponible'}</p>
        <p><strong>{themeCount}</strong> {themeCount > 1 ? 'thèmes abordés' : 'thème abordé'}</p>
        <p><strong>100%</strong> gratuit</p>
      </div>
      <p class="anchor-row">
        <a href="#jouer-maintenant" class="cta-button cta-primary">Jouer maintenant</a>
      </p>
    </div>

    <div id="jouer-maintenant" class="games-grid" role="list" aria-label="Liste des jeux">
      {jeux.map((jeu, index) => <GameCard jeu={jeu} index={index} />)}
    </div>

    <div class="hub-bottom-grid">
      <article class="hub-panel reveal reveal-1">
        <h3>Pour qui sont ces jeux ?</h3>
        <ul>
          <li>Familles et adolescents.</li>
          <li>Associations et médiateurs numériques.</li>
          <li>Animateurs d'ateliers et structures éducatives.</li>
        </ul>
      </article>

      <article class="hub-panel reveal reveal-2">
        <h3>Besoin d'un atelier sur mesure ?</h3>
        <p>
          Contactez-nous pour organiser une session adaptée à votre public: niveau, contexte terrain et
          objectifs pédagogiques.
        </p>
        <p><a href="/contact">Nous contacter</a></p>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  :global(.games-hub) { display: grid; gap: 22px; }
  :global(.games-hub h2), :global(.games-hub h3) { margin: 0; }
  :global(.hub-intro-card), :global(.hub-panel), :global(.game-card) {
    position: relative; background: linear-gradient(160deg, rgba(18, 30, 60, 0.9), rgba(10, 18, 40, 0.94));
    border: 1px solid rgba(144, 177, 222, 0.24); border-radius: 20px; padding: clamp(1rem, 2.2vw, 1.55rem); overflow: hidden;
  }
  :global(.hub-intro-card::before), :global(.game-card::before) { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, rgba(95, 232, 255, 0.08), transparent 46%); pointer-events: none; }
  :global(.hub-intro-card::after), :global(.game-card::after) { content: ''; position: absolute; inset: auto -80px -100px auto; width: 180px; aspect-ratio: 1; background: radial-gradient(circle, rgba(71, 255, 228, 0.2), transparent 70%); pointer-events: none; }
  :global(.hub-kicker) { margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; font-size: 0.82rem; color: rgba(86, 226, 241, 0.96); }
  :global(.hub-stats) { margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
  :global(.hub-stats p) { margin: 0; padding: 8px 10px; border: 1px solid rgba(130, 167, 214, 0.3); border-radius: 12px; background: rgba(10, 24, 47, 0.5); font-size: 0.95rem; }
  :global(.hub-stats strong) { color: rgba(135, 255, 236, 0.95); }
  :global(.anchor-row) { margin: 14px 0 0; }
  :global(.anchor-row .cta-button) { min-width: 220px; }
  :global(.games-grid) { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; scroll-margin-top: 120px; }
  :global(.hub-bottom-grid) { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  :global(.hub-panel ul) { margin: 10px 0 0; padding-left: 18px; }
  :global(.hub-panel li + li) { margin-top: 6px; }
  :global(.reveal) { opacity: 0; transform: translateY(8px); animation: hubReveal 0.62s ease forwards; }
  :global(.reveal-0) { animation-delay: 0.03s; }
  :global(.reveal-1) { animation-delay: 0.08s; }
  :global(.reveal-2) { animation-delay: 0.14s; }
  @keyframes hubReveal { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { :global(.reveal) { opacity: 1; transform: none; animation: none; } }
  @media (max-width: 640px) {
    :global(.hub-intro-card), :global(.hub-panel), :global(.game-card) { border-radius: 16px; }
    :global(.anchor-row .cta-button) { width: 100%; min-width: 0; }
  }
</style>
