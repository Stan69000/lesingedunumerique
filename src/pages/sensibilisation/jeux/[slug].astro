---
import { marked } from 'marked';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { jeux, jeuTitle, jeuDescription, type Jeu } from '../../../lib/jeux';
import { siteSettings } from '../../../config/site';
import '../../../styles/jeux.css';

export function getStaticPaths() {
  return jeux.map((jeu) => ({ params: { slug: jeu.slug }, props: { jeu } }));
}

interface Props {
  jeu: Jeu;
}

const { jeu } = Astro.props;
const pageUrl = new URL(`/sensibilisation/jeux/${jeu.slug}/`, siteSettings.siteUrl).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/` },
    { '@type': 'ListItem', position: 3, name: 'Jeux de sensibilisation', item: `${siteSettings.siteUrl}/sensibilisation/jeux/` },
    { '@type': 'ListItem', position: 4, name: jeu.name, item: pageUrl },
  ],
};

const bodyHtml = jeu.bodyMd ? marked.parse(jeu.bodyMd) : '';
---

<SiteLayout
  title={jeuTitle(jeu)}
  description={jeuDescription(jeu)}
  eyebrow="Sensibilisation"
  headline={jeu.name}
  accent="jeu interactif"
  intro={jeu.intro || jeu.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="game-host" aria-labelledby="game-title">
    <article class="game-intro-card reveal reveal-0">
      <div class="game-top-row">
        {jeu.ageRange && <p class="game-badge">{jeu.ageRange}</p>}
        <a href="/sensibilisation/jeux" class="mini-link">Voir tous les jeux</a>
      </div>
      <h2 id="game-title">Jouer pour déclencher la discussion</h2>
      {jeu.description && <p>{jeu.description}</p>}
      {jeu.tags.length > 0 && (
        <ul class="risk-tags" aria-label={`Thèmes de ${jeu.name}`}>
          {jeu.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      <div class="cta-row">
        <a href="#jouer-maintenant" class="cta-button cta-primary">Jouer maintenant</a>
        <a href={jeu.embedUrl} class="cta-button cta-secondary" target="_blank" rel="noopener noreferrer">
          Ouvrir en plein écran
        </a>
      </div>
    </article>

    <div id="jouer-maintenant" class="frame-shell reveal reveal-1">
      <iframe
        src={jeu.embedUrl}
        title={`Jeu ${jeu.name}`}
        loading="lazy"
        class="game-frame"
        allow="fullscreen"
      ></iframe>
    </div>

    {bodyHtml && (
      <article class="game-description reveal reveal-2">
        <div set:html={bodyHtml} />
        <p>
          Vous animez un atelier de prévention numérique ? Retrouvez toute la
          <a href="/sensibilisation/jeux"> bibliothèque de jeux de sensibilisation</a>.
        </p>
      </article>
    )}
  </section>
</SiteLayout>
