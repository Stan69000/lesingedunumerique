---
import LexiqueRelated from '../../../components/LexiqueRelated.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getPublishedBriefs, formatBriefDay, formatBriefPeriod, formatBriefShortDate } from '../../../lib/briefs';
import { layoutBrief, matchBd } from '../../../lib/brief-layout.mjs';
import { getPlanches, planchePath } from '../../../lib/bd';
import bdRules from '../../../data/brief-bd.json';

export async function getStaticPaths() {
  const briefs = await getPublishedBriefs();
  return briefs.map((brief) => ({ params: { slug: brief.id }, props: { brief, briefs } }));
}

const { brief, briefs } = Astro.props;
const { data } = brief;
const body = brief.body ?? '';
const layout = layoutBrief(body);

// Les ancres et le sommaire reprennent les identifiants du frontmatter, dans l'ordre.
const scamIds = layout.scams.map((scam, index) => data.scams[index]?.id ?? `arnaque-${scam.number}`);

// La même arnaque traitée dans une autre édition publiée (jamais la démonstration).
const editions = data.demo ? [] : briefs.filter((other) => other.id !== brief.id && !other.data.demo);
const recurrences = scamIds.map((id) => editions
  .filter((other) => other.data.scams.some((scam) => scam.id === id))
  .sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
  .map((other) => ({
    href: `/veille/briefs/${other.id}/#${id}`,
    label: `${other.data.pubDate < data.pubDate ? 'Déjà traitée' : 'Revue'} le ${formatBriefShortDate(other.data.pubDate)}`,
  })));

const planches = await getPlanches();
const bdFor = matchBd(scamIds, bdRules).map((slug) => planches.find((planche) => planche.id === slug) ?? null);

const typeLabel = data.type === 'monthly' ? 'Mensuel' : data.type === 'weekly' ? 'Hebdomadaire' : 'Conseils pratiques';
const minutes = Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 200));
const sourceParts = (title: string, url: string) => {
  const [site, ...rest] = title.split(' — ');
  return { title: rest.length ? rest.join(' — ') : title, site: rest.length ? site : new URL(url).hostname.replace(/^www\./, '') };
};
const icons: Record<string, string> = { trap: '🎣', why: '🧠', alert: '⚠️' };
---
<SiteLayout title={`${data.title} | Le Singe du Numérique`} description={data.description} eyebrow="Le décryptage d’Octet" headline={data.title} intro={data.description}>
  <ul slot="hero" class="brief-chips" aria-label="À propos de cette édition">
    {data.demo
      ? <li>Exemple créé le <time datetime={data.pubDate.toISOString()}>{formatBriefDay(data.pubDate)}</time></li>
      : <>
          {data.type !== 'evergreen' && <li class="chip-period"><span aria-hidden="true">📅</span> {formatBriefPeriod(data.periodStart, data.periodEnd)}</li>}
          <li>Publié le <time datetime={data.pubDate.toISOString()}>{formatBriefDay(data.pubDate)}</time></li>
        </>}
    <li>{typeLabel}</li>
    <li><span aria-hidden="true">⏱</span> {minutes} min de lecture</li>
  </ul>

  <div class="brief-detail">
    <nav class="crumbs" aria-label="Navigation des décryptages"><a href="/veille/">Veille</a> · <a href="/veille/briefs/">Tous les décryptages</a></nav>
    {data.demo && <aside class="notice"><strong>Démonstration.</strong> Ce contenu illustre le format. Il ne décrit pas les arnaques observées pendant cette période.</aside>}

    {layout.introHtml && (
      <div class="octet-word">
        <span class="avatar" aria-hidden="true">🐒</span>
        <div><p class="who">Le mot d’Octet</p><div class="prose" set:html={layout.introHtml} /></div>
      </div>
    )}

    {layout.scams.length > 1 && (
      <nav class="toc" aria-label="Les arnaques de cette édition">
        <ol>
          {layout.scams.map((scam, index) => (
            <li><a href={`#${scamIds[index]}`}>
              <span class="toc-num" aria-hidden="true">{scam.number.padStart(2, '0')}</span>
              <span class="toc-title">{scam.title}</span>
              {scam.status[0] && <span class="toc-status">{scam.status[0]}</span>}
            </a></li>
          ))}
        </ol>
      </nav>
    )}

    {layout.scams.map((scam, index) => {
      const bd = bdFor[index];
      const plain = scam.blocks.filter((block) => block.kind === 'trap' || block.kind === 'why');
      const others = scam.blocks.filter((block) => block.kind !== 'trap' && block.kind !== 'why');
      return (
        <article class="scam" id={scamIds[index]} aria-labelledby={`${scamIds[index]}-titre`}>
          <header class="scam-head">
            <span class="scam-num" aria-hidden="true">{scam.number.padStart(2, '0')}</span>
            <div>
              <h2 id={`${scamIds[index]}-titre`}><span class="sr-only">Arnaque {scam.number} : </span>{scam.title}</h2>
              {(scam.status.length > 0 || recurrences[index].length > 0) && (
                <ul class="tags" aria-label="Statut">
                  {scam.status.map((tag) => <li class="tag">{tag}</li>)}
                  {recurrences[index].map((edition) => <li><a class="tag tag-link" href={edition.href}><span aria-hidden="true">↻ </span>{edition.label}</a></li>)}
                </ul>
              )}
            </div>
          </header>
          <div class="scam-body">
            {plain.length > 0 && (
              <div class="scam-row">
                {plain.map((block) => <section class="block block-plain"><h3><span aria-hidden="true">{icons[block.kind]}</span> {block.label}</h3><p set:html={block.html} /></section>)}
              </div>
            )}
            {others.map((block) => block.kind === 'reflex'
              ? <section class="block block-reflex"><span class="avatar" aria-hidden="true">🐒</span><div><h3>{block.label}</h3><p set:html={block.html} /></div></section>
              : <section class="block block-alert"><h3><span aria-hidden="true">{icons[block.kind]}</span> {block.label}</h3><p set:html={block.html} /></section>)}
            {scam.notesHtml && <div class="scam-notes prose" set:html={scam.notesHtml} />}
          </div>
          {bd && (
            <footer class="scam-foot">
              <a class="bd-link" href={planchePath(bd)}>
                <img src={bd.data.planche} alt="" width="64" height="64" loading="lazy" decoding="async" />
                <span><small>En BD avec Octet</small><strong>{bd.data.title}</strong></span>
              </a>
            </footer>
          )}
        </article>
      );
    })}

    {layout.sections.map((section) => section.kind === 'retain'
      ? <>
          <section class="retain">
            <h2 class="retain-label">{section.title}</h2>
            <blockquote set:html={section.quoteHtml} />
            <span class="retain-mark" aria-hidden="true">”</span>
          </section>
          {section.html && <div class="prose" set:html={section.html} />}
        </>
      : <section class:list={['closing', `closing-${section.kind}`]}>
          <h2>{section.kind === 'trapped' && <span aria-hidden="true">🆘 </span>}{section.title}</h2>
          <div class="prose" set:html={section.html} />
        </section>)}

    {!data.demo && <LexiqueRelated path={Astro.url.pathname} />}

    <section class="sources" aria-labelledby="brief-sources">
      <h2 id="brief-sources">Pour vérifier et aller plus loin</h2>
      <ul>
        {data.sources.map((source) => {
          const { title, site } = sourceParts(source.title, source.url);
          return <li><a href={source.url}><span class="source-site">{site}</span><span class="source-title">{title}</span><span aria-hidden="true">↗</span></a></li>;
        })}
      </ul>
    </section>
    <p class="back"><a href="/veille/briefs/">← Tous les décryptages d’Octet</a></p>
  </div>
</SiteLayout>
<style>
  .brief-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .brief-chips li { display: inline-block; padding: .3rem .8rem; border: 1px solid var(--border-color); border-radius: 999px; background: var(--bg-card); font-size: .88rem; }
  .brief-chips li > span[aria-hidden] { margin-right: .35rem; }
  .brief-chips .chip-period { color: var(--brand-green); border-color: color-mix(in srgb, var(--brand-green) 35%, transparent); font-weight: 500; }

  .brief-detail { max-width: 860px; margin-inline: auto; line-height: 1.7; overflow-wrap: anywhere; }
  .brief-detail :global(a) { color: var(--brand-green); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs { margin-bottom: 1.5rem; color: var(--text-muted); font-size: .92rem; }
  .notice { padding: 1rem 1.25rem; margin-block: 1.5rem; border: 1px solid var(--border-color); border-left: 4px solid var(--brand-orange); border-radius: 12px; background: var(--bg-card); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .prose :global(p) { margin: 0 0 .75rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }

  .avatar { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: color-mix(in srgb, var(--brand-green) 16%, var(--bg-card)); font-size: 1.4rem; }
  .octet-word { display: flex; gap: 1rem; align-items: flex-start; padding: 1.1rem 1.25rem; border: 1px solid var(--border-color); border-radius: 16px; background: var(--bg-card); }
  .octet-word .who { margin: 0 0 .15rem; font-weight: 700; }

  .toc ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .75rem; margin: 1.5rem 0 2.5rem; padding: 0; list-style: none; }
  .brief-detail .toc a { display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: 1rem; border: 1px solid var(--border-color); border-radius: 14px; background: var(--bg-card); color: inherit; text-decoration: none; transition: border-color .15s, transform .15s; }
  .brief-detail .toc a:hover { border-color: var(--brand-green); transform: translateY(-2px); }
  .toc-num { font-family: "JetBrains Mono", monospace; font-size: .8rem; color: var(--brand-green); }
  .toc-title { font-weight: 700; line-height: 1.3; }
  .toc-status { color: var(--text-muted); font-size: .8rem; line-height: 1.4; }

  .scam { margin: 0 0 2rem; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-card); overflow: hidden; scroll-margin-top: calc(var(--nav-height, 70px) + 1rem); }
  .scam-head { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; padding: 1.5rem 1.5rem 1rem; }
  .scam-num { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--brand-green); color: var(--bg-body); font-family: "JetBrains Mono", monospace; font-size: 1.4rem; font-weight: 500; }
  .scam h2 { margin: 0 0 .45rem; font-size: 1.45rem; line-height: 1.25; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .tag { display: inline-block; padding: .15rem .65rem; border: 1px solid var(--border-color); border-radius: 999px; color: var(--text-muted); font-size: .78rem; line-height: 1.5; }
  .brief-detail .tag-link { color: var(--brand-blue); border-color: color-mix(in srgb, var(--brand-blue) 40%, transparent); text-decoration: none; }
  .brief-detail .tag-link:hover { text-decoration: underline; }
  .scam-body { display: grid; gap: 1rem; padding: 0 1.5rem 1.5rem; }
  .scam-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .block { padding: 1rem 1.1rem; border-radius: 14px; }
  .block h3 { display: flex; align-items: center; gap: .5rem; margin: 0 0 .35rem; color: var(--text-muted); font-family: "JetBrains Mono", monospace; font-size: .78rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .block p { margin: 0; }
  .block-plain { background: color-mix(in srgb, var(--text-main) 4%, transparent); }
  .block-alert { border: 1px solid color-mix(in srgb, var(--brand-orange) 30%, transparent); background: color-mix(in srgb, var(--brand-orange) 9%, var(--bg-card)); }
  .block-alert h3 { color: var(--brand-orange); }
  .block-reflex { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; border: 1px solid color-mix(in srgb, var(--brand-green) 35%, transparent); background: color-mix(in srgb, var(--brand-green) 11%, var(--bg-card)); }
  .block-reflex h3 { color: var(--brand-green); }
  .block-reflex p { font-size: 1.08rem; font-weight: 500; }
  .scam-notes { color: var(--text-muted); font-size: .95rem; }
  .scam-foot { padding: 1rem 1.5rem; border-top: 1px solid var(--border-color); }
  .brief-detail .bd-link { display: inline-flex; gap: .8rem; align-items: center; color: inherit; text-decoration: none; }
  .bd-link img { width: 64px; height: 64px; object-fit: cover; object-position: top; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-body); }
  .bd-link small { display: block; color: var(--text-muted); font-size: .78rem; }
  .bd-link strong { color: var(--brand-green); }
  .bd-link:hover strong { text-decoration: underline; text-underline-offset: 3px; }

  .retain { position: relative; margin: 3rem 0 1.5rem; padding: 2.25rem 2rem; border-radius: 24px; background: linear-gradient(135deg, var(--brand-green), color-mix(in srgb, var(--brand-green) 55%, var(--brand-blue))); color: var(--bg-body); overflow: hidden; }
  .retain-label { margin: 0 0 .5rem; font-weight: 400; font-family: "JetBrains Mono", monospace; font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; opacity: .85; }
  .retain blockquote { position: relative; margin: 0; padding-right: 3.5rem; font-size: clamp(1.4rem, 3.2vw, 2rem); font-weight: 700; line-height: 1.3; }
  .retain-mark { position: absolute; right: 1.25rem; bottom: -2.5rem; font-size: 9rem; line-height: 1; opacity: .15; }

  .closing { margin: 2rem 0; }
  .closing h2 { margin: 0 0 .75rem; font-size: 1.3rem; }
  .closing-reflexes :global(ol) { display: grid; gap: .6rem; margin: 0; padding: 0; list-style: none; counter-reset: reflexe; }
  .closing-reflexes :global(li) { position: relative; padding: .8rem 1rem .8rem 3.25rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--bg-card); counter-increment: reflexe; }
  .closing-reflexes :global(li)::before { content: counter(reflexe); position: absolute; left: 1rem; top: .8rem; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--brand-green); color: var(--bg-body); font-family: "JetBrains Mono", monospace; font-size: .85rem; }
  .closing-trapped { padding: 1.5rem; border: 2px solid var(--brand-orange); border-radius: 20px; background: color-mix(in srgb, var(--brand-orange) 6%, var(--bg-card)); }

  .sources h2 { margin: 2.5rem 0 1rem; font-size: 1.2rem; }
  .sources ul { display: grid; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .brief-detail .sources a { display: grid; grid-template-columns: 1fr auto; gap: .15rem .9rem; align-items: center; padding: .85rem 1rem; border: 1px solid var(--border-color); border-radius: 12px; background: var(--bg-card); color: inherit; text-decoration: none; }
  .brief-detail .sources a:hover { border-color: var(--brand-green); }
  .source-site { grid-column: 1; color: var(--brand-blue); font-family: "JetBrains Mono", monospace; font-size: .75rem; }
  .source-title { grid-column: 1; }
  .sources a > span[aria-hidden] { grid-column: 2; grid-row: 1 / span 2; color: var(--brand-green); }
  .back { margin-top: 2.5rem; }

  @media (max-width: 640px) {
    .scam-head { grid-template-columns: 1fr; gap: .6rem; padding: 1.1rem 1.1rem .75rem; }
    .scam-body { padding: 0 1.1rem 1.1rem; }
    .scam-foot { padding: 1rem 1.1rem; }
    .scam-num { width: 46px; height: 46px; border-radius: 13px; font-size: 1.15rem; }
    .scam h2 { font-size: 1.25rem; }
    .block-reflex { grid-template-columns: 1fr; }
    .retain { padding: 1.75rem 1.25rem; }
    .retain blockquote { padding-right: 0; }
    .closing-trapped { padding: 1.1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .brief-detail .toc a { transition: none; } .brief-detail .toc a:hover { transform: none; } }
</style>
