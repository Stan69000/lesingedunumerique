---
import SiteLayout from '../layouts/SiteLayout.astro';
import GameCard from '../components/GameCard.astro';
import { jeux } from '../lib/jeux';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://lesingedunumerique.fr/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sensibilisation au numérique',
      item: 'https://lesingedunumerique.fr/sensibilisation/',
    },
  ],
};

const themeCount = new Set(jeux.flatMap((jeu) => jeu.tags.map((tag) => tag.toLowerCase()))).size;
---

<SiteLayout
  title="Sensibilisation au numérique et cybersécurité | Le Singe Du Numerique"
  description="Ressources gratuites de sensibilisation au numérique et à la cybersécurité: jeux pédagogiques, réflexes concrets et contenus accessibles pour parents, enfants et associations."
  eyebrow="Sensibilisation"
  headline="Ressources"
  accent="de sensibilisation"
  intro="Un espace dédié à la sensibilisation au numérique: contenus courts, jeux pédagogiques et bons réflexes de cybersécurité pour tous les âges."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="sensibilisation-hub" aria-labelledby="sensibilisation-hub-title">
    <div class="hub-intro-card reveal reveal-0">
      <p class="hub-kicker">Nouveaux contenus en ligne</p>
      <h2 id="sensibilisation-hub-title">Bibliothèque de jeux pédagogiques</h2>
      <p>
        Plusieurs jeux sont déjà disponibles pour sensibiliser aux arnaques, à la protection des données,
        aux réseaux sociaux et aux réflexes cyber du quotidien.
      </p>
      <p>
        Chaque ressource est conçue pour être utilisée en famille, en atelier, en association ou en classe,
        avec des scénarios concrets et accessibles.
      </p>
      <div class="hub-stats" aria-label="Aperçu des contenus disponibles">
        <p><strong>{jeux.length}</strong> {jeux.length > 1 ? 'jeux disponibles' : 'jeu disponible'}</p>
        <p><strong>{themeCount}</strong> {themeCount > 1 ? 'thèmes cyber abordés' : 'thème cyber abordé'}</p>
        <p><strong>100%</strong> gratuit</p>
      </div>
      <p class="anchor-row">
        <a href="#jouer-maintenant" class="cta-button cta-primary">Jouer maintenant</a>
      </p>
    </div>

    <div id="jouer-maintenant" class="games-grid" role="list" aria-label="Jeux de sensibilisation disponibles">
      {jeux.map((jeu, index) => <GameCard jeu={jeu} index={index} />)}
    </div>

    <div class="hub-bottom-grid">
      <article class="hub-panel reveal reveal-1">
        <h3>Pour qui ?</h3>
        <ul>
          <li>Familles et parents qui veulent lancer la discussion.</li>
          <li>Associations et médiateurs numériques en intervention terrain.</li>
          <li>Structures éducatives cherchant des supports pratiques.</li>
        </ul>
      </article>

      <article class="hub-panel reveal reveal-2">
        <h3>Comment utiliser ces ressources ?</h3>
        <p>
          Lancez un jeu, débriefez les situations rencontrées, puis adaptez les conseils à votre contexte.
          C'est un format simple pour transformer la prévention en réflexes durables.
        </p>
      </article>
    </div>

    <ul class="cta-row reveal reveal-3">
      <li><a href="/sensibilisation/jeux" class="cta-button cta-primary">Voir tous les jeux</a></li>
      <li><a href="/contact" class="cta-button cta-secondary">Nous partager un besoin</a></li>
    </ul>
  </section>
</SiteLayout>

<style>
  :global(.sensibilisation-hub) {
    display: grid;
    gap: 22px;
  }

  :global(.sensibilisation-hub h2),
  :global(.sensibilisation-hub h3) {
    margin: 0;
  }

  :global(.hub-intro-card),
  :global(.hub-panel),
  :global(.game-card) {
    position: relative;
    background: linear-gradient(160deg, rgba(18, 30, 60, 0.9), rgba(10, 18, 40, 0.94));
    border: 1px solid rgba(144, 177, 222, 0.24);
    border-radius: 20px;
    padding: clamp(1rem, 2.2vw, 1.55rem);
    overflow: hidden;
  }

  :global(.hub-intro-card::before),
  :global(.game-card::before) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(95, 232, 255, 0.08), transparent 46%);
    pointer-events: none;
  }

  :global(.hub-intro-card::after),
  :global(.game-card::after) {
    content: '';
    position: absolute;
    inset: auto -80px -100px auto;
    width: 180px;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(71, 255, 228, 0.2), transparent 70%);
    pointer-events: none;
  }

  :global(.hub-kicker) {
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 0.82rem;
    color: rgba(86, 226, 241, 0.96);
  }

  :global(.hub-stats) {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
  }

  :global(.hub-stats p) {
    margin: 0;
    padding: 8px 10px;
    border: 1px solid rgba(130, 167, 214, 0.3);
    border-radius: 12px;
    background: rgba(10, 24, 47, 0.5);
    font-size: 0.95rem;
  }

  :global(.hub-stats strong) {
    color: rgba(135, 255, 236, 0.95);
  }

  :global(.anchor-row) {
    margin: 14px 0 0;
  }

  :global(.anchor-row .cta-button) {
    min-width: 220px;
  }

  :global(.games-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 14px;
    scroll-margin-top: 120px;
  }

  :global(.hub-bottom-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  :global(.hub-panel ul) {
    margin: 10px 0 0;
    padding-left: 18px;
  }

  :global(.hub-panel li + li) {
    margin-top: 6px;
  }

  :global(.sensibilisation-hub .cta-row) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
    align-items: stretch;
  }

  :global(.sensibilisation-hub .cta-row li) {
    display: flex;
  }

  :global(.sensibilisation-hub .cta-row .cta-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    width: 100%;
    text-align: center;
    text-decoration: none !important;
    line-height: 1.2;
  }

  :global(.reveal) {
    opacity: 0;
    transform: translateY(8px);
    animation: hubReveal 0.62s ease forwards;
  }

  :global(.reveal-0) { animation-delay: 0.03s; }
  :global(.reveal-1) { animation-delay: 0.08s; }
  :global(.reveal-2) { animation-delay: 0.14s; }
  :global(.reveal-3) { animation-delay: 0.2s; }

  @keyframes hubReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.reveal) {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 640px) {
    :global(.hub-intro-card),
    :global(.hub-panel),
    :global(.game-card) {
      border-radius: 16px;
    }

    :global(.anchor-row .cta-button) {
      width: 100%;
      min-width: 0;
    }
  }
</style>
