---
import SiteLayout from '../layouts/SiteLayout.astro';
import GameCard from '../components/GameCard.astro';
import { getJeux, jeuxALaUne, jeuxDisponibles, themesCouverts } from '../lib/jeux';
import { siteSettings } from '../config/site';
import '../styles/jeux.css';

const jeux = await getJeux();
const disponibles = jeuxDisponibles(jeux);
const misEnAvant = jeuxALaUne(jeux, 3);
const themes = themesCouverts(jeux);
const autresJeux = jeux.length - misEnAvant.length;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sensibilisation au numérique',
      item: `${siteSettings.siteUrl}/sensibilisation/`,
    },
  ],
};
---

<SiteLayout
  title="Sensibilisation au numérique et cybersécurité | Le Singe Du Numerique"
  description="Ressources gratuites de sensibilisation au numérique et à la cybersécurité: jeux pédagogiques, réflexes concrets et contenus accessibles pour parents, enfants et associations."
  eyebrow="Sensibilisation"
  headline="Ressources"
  accent="de sensibilisation"
  intro="Des supports courts et concrets pour parler numérique et cybersécurité en famille, en atelier ou en classe."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="hub">
    <section class="hub-card reveal reveal-0" aria-labelledby="demarche-titre">
      <p class="hub-kicker">Notre démarche</p>
      <h2 id="demarche-titre">Sensibiliser sans faire peur, ni minimiser</h2>
      <p>
        Nous produisons des ressources gratuites qui partent de situations réelles: un SMS d'arnaque, un
        inconnu trop sympathique, une vidéo truquée qui circule. L'objectif n'est pas de tout interdire, mais
        de créer un moment de discussion et d'installer des réflexes qui tiennent dans la durée.
      </p>
      <ul class="hub-stats">
        <li><strong>{disponibles.length}</strong> {disponibles.length > 1 ? 'jeux jouables' : 'jeu jouable'} en ligne</li>
        <li><strong>{themes.length}</strong> thèmes cyber abordés</li>
        <li><strong>100%</strong> gratuit et sans inscription</li>
      </ul>
    </section>

    <section aria-labelledby="jeux-titre">
      <div class="section-head">
        <div>
          <p class="hub-kicker">Nos jeux pédagogiques</p>
          <h2 id="jeux-titre">Apprendre en jouant</h2>
        </div>
        <a href="/sensibilisation/jeux" class="cta-button">
          Voir le catalogue{autresJeux > 0 ? ` (${jeux.length} jeux)` : ''}
        </a>
      </div>

      <p class="section-intro">
        Chaque jeu se joue dans le navigateur, sans compte et sans collecte de données. Voici les plus
        utilisés en ce moment.
      </p>

      <div class="games-grid" role="list" aria-label="Jeux mis en avant">
        {misEnAvant.map((jeu) => <GameCard jeu={jeu} niveauTitre="h3" />)}
      </div>

      {
        autresJeux > 0 && (
          <p class="section-more">
            <a href="/sensibilisation/jeux">
              {autresJeux > 1 ? `Voir les ${autresJeux} autres jeux` : "Voir l'autre jeu"} et filtrer par public
              ou par thème
            </a>
          </p>
        )
      }
    </section>

    <div class="hub-bottom">
      <section class="game-panel reveal reveal-2" aria-labelledby="pour-qui-titre">
        <h2 id="pour-qui-titre">Pour qui ?</h2>
        <p><strong>Tout le monde.</strong> Aucune base technique n'est nécessaire.</p>
        <ul>
          <li>Familles et parents qui veulent lancer la discussion.</li>
          <li>Associations et médiateurs numériques en intervention terrain.</li>
          <li>Structures éducatives cherchant des supports pratiques.</li>
          <li>Et n'importe qui d'autre, curieux comme déjà à l'aise.</li>
        </ul>
      </section>

      <section class="game-panel reveal reveal-3" aria-labelledby="comment-titre">
        <h2 id="comment-titre">Comment utiliser ces ressources ?</h2>
        <ol>
          <li>Lancez un jeu adapté à l'âge du public.</li>
          <li>Débriefez les situations rencontrées, sans corriger trop vite.</li>
          <li>Adaptez les conseils au contexte réel des participants.</li>
        </ol>
      </section>
    </div>

    <section class="hub-card reveal reveal-3" aria-labelledby="suite-titre">
      <h2 id="suite-titre">Et la suite ?</h2>
      <p>
        D'autres jeux et formats sont en préparation. Vous animez des ateliers et un sujet vous manque ?
        Dites-le nous, nos prochaines ressources sont construites à partir des besoins remontés du terrain.
      </p>
      <ul class="cta-row">
        <li><a href="/sensibilisation/jeux" class="cta-button">Voir tous les jeux</a></li>
        <li><a href="/contact" class="cta-button cta-secondary">Nous partager un besoin</a></li>
      </ul>
    </section>
  </div>
</SiteLayout>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 8px;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-intro {
    margin: 0 0 18px;
    color: var(--text-muted);
    max-width: 68ch;
  }

  .section-more {
    margin: 16px 0 0;
  }

  .section-more a {
    color: var(--brand-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .section-more a:hover {
    color: var(--text-main);
  }

  .hub-bottom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .hub-bottom ol,
  .hub-bottom ul {
    margin: 12px 0 0;
    padding-left: 20px;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .hub-bottom li + li {
    margin-top: 8px;
  }

  :global(.hub .cta-row) {
    margin-top: 18px;
  }
</style>
