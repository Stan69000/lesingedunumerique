---
import SiteLayout from '../layouts/SiteLayout.astro';
import GameCard from '../components/GameCard.astro';
import {
  jeux, jeuxALaUne, nouveautes, nombreDeThemes, optionsUtilisees, lienCatalogue, valeurs, type Facette,
} from '../lib/jeux';
import { siteSettings } from '../config/site';
import '../styles/jeux.css';

const recents = nouveautes(3);
const misEnAvant = recents.length > 0 ? recents : jeuxALaUne(3);
const autresJeux = jeux.length - misEnAvant.length;
const themeCount = nombreDeThemes();

// Entrées par besoin : la question qu'on se pose avant de choisir un jeu.
const BESOINS: Array<{ facette: Facette; cle: string; titre: string; texte: string }> = [
  { facette: 'public', cle: 'enfants', titre: 'Pour les enfants', texte: 'Des situations simples pour en parler avant 12 ans.' },
  { facette: 'public', cle: 'ados', titre: 'Avec des ados', texte: 'Réseaux, arnaques, infos virales : leurs vrais sujets.' },
  { facette: 'public', cle: 'parents', titre: 'Pour les parents', texte: 'Faire le point et accompagner son enfant en ligne.' },
  { facette: 'public', cle: 'seniors', titre: 'Pour les seniors', texte: 'Repérer les faux appels et faire le point sereinement.' },
  { facette: 'format', cle: 'groupe', titre: 'En famille ou à plusieurs', texte: 'Un écran pour plusieurs, et de quoi débattre.' },
  { facette: 'format', cle: 'atelier', titre: 'En classe ou en atelier', texte: 'Des jeux à animer avec un groupe.' },
];
const besoins = BESOINS.map((b) => ({
  ...b,
  jeux: jeux.filter((j) => valeurs(j, b.facette).includes(b.cle)).length,
})).filter((b) => b.jeux > 0);
const themes = optionsUtilisees('theme');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteSettings.siteUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sensibilisation au numérique',
      item: `${siteSettings.siteUrl}/sensibilisation/`,
    },
  ],
};
---

<SiteLayout
  title="Jeux pour comprendre le numérique et la cybersécurité | Le Singe Du Numérique"
  description="Ressources gratuites de sensibilisation au numérique et à la cybersécurité: jeux pédagogiques, réflexes concrets et contenus accessibles pour parents, enfants et associations."
  eyebrow="Sensibilisation"
  headline="Jeux"
  accent="pour comprendre le numérique"
  intro="Des supports courts et concrets pour parler numérique et cybersécurité en famille, en atelier ou en classe."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="hub">
    <section class="hub-card reveal reveal-0" aria-labelledby="demarche-titre">
      <p class="hub-kicker">Notre démarche</p>
      <h2 id="demarche-titre">Sensibiliser sans faire peur, ni minimiser</h2>
      <p>
        Nous produisons des ressources gratuites qui partent de situations réelles: un SMS d'arnaque, un
        inconnu trop sympathique, une vidéo truquée qui circule. L'objectif n'est pas de tout interdire, mais
        de créer un moment de discussion et d'installer des réflexes qui tiennent dans la durée.
      </p>
      <ul class="hub-stats">
        <li><strong>{jeux.length}</strong> {jeux.length > 1 ? 'jeux disponibles' : 'jeu disponible'}</li>
        <li><strong>{themeCount}</strong> {themeCount > 1 ? 'thèmes cyber abordés' : 'thème cyber abordé'}</li>
        <li><strong>100%</strong> gratuit et sans inscription</li>
      </ul>
    </section>

    {
      besoins.length >= 2 && (
        <section aria-labelledby="besoins-titre">
          <p class="hub-kicker">Par où commencer ?</p>
          <h2 id="besoins-titre">Trouver le bon jeu</h2>
          <p class="section-intro">Choisissez votre situation : le catalogue s'ouvre déjà filtré.</p>
          <ul class="needs-grid">
            {besoins.map((b) => (
              <li>
                <a class="need-tile" href={lienCatalogue(b.facette, b.cle)}>
                  <strong>{b.titre}</strong>
                  <span>{b.texte}</span>
                  <small>{b.jeux} {b.jeux > 1 ? 'jeux' : 'jeu'}</small>
                </a>
              </li>
            ))}
          </ul>
          {themes.length >= 2 && (
            <>
              <h3 class="theme-links-title">Ou par sujet</h3>
              <ul class="theme-links">
                {themes.map((t) => (
                  <li>
                    <a href={lienCatalogue('theme', t.key)}>
                      {t.label} <span aria-hidden="true">·</span> <span>{t.jeux}<span class="sr-only"> {t.jeux > 1 ? 'jeux' : 'jeu'}</span></span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }

    <section aria-labelledby="jeux-titre">
      <div class="section-head">
        <div>
          <p class="hub-kicker">{recents.length > 0 ? 'Nouveautés' : 'Nos jeux pédagogiques'}</p>
          <h2 id="jeux-titre">{recents.length > 0 ? 'Les derniers jeux en ligne' : 'Apprendre en jouant'}</h2>
        </div>
        <a href="/sensibilisation/jeux/" class="cta-button">Voir les {jeux.length} jeux</a>
      </div>

      <p class="section-intro">
        Chaque jeu se joue dans le navigateur, sans compte et sans collecte de données.
      </p>

      <div class="games-grid" role="list" aria-label={recents.length > 0 ? 'Derniers jeux en ligne' : 'Jeux mis en avant'}>
        {misEnAvant.map((jeu, index) => <GameCard jeu={jeu} index={index} />)}
      </div>

      {
        autresJeux > 0 && (
          <p class="section-more">
            <a href="/sensibilisation/jeux/">
              {autresJeux > 1 ? `Voir les ${autresJeux} autres jeux` : "Voir l'autre jeu"} du catalogue
            </a>
          </p>
        )
      }
    </section>

    <div class="hub-bottom-grid">
      <section class="hub-panel reveal reveal-2" aria-labelledby="pour-qui-titre">
        <h2 id="pour-qui-titre">Pour qui ?</h2>
        <p><strong>Tout le monde.</strong> Aucune base technique n'est nécessaire.</p>
        <ul>
          <li>Familles et parents qui veulent lancer la discussion.</li>
          <li>Associations et médiateurs numériques en intervention terrain.</li>
          <li>Structures éducatives cherchant des supports pratiques.</li>
          <li>Et n'importe qui d'autre, curieux comme déjà à l'aise.</li>
        </ul>
      </section>

      <section class="hub-panel reveal reveal-3" aria-labelledby="comment-titre">
        <h2 id="comment-titre">Comment utiliser ces ressources ?</h2>
        <ol>
          <li>Lancez un jeu adapté à l'âge du public.</li>
          <li>Débriefez les situations rencontrées, sans corriger trop vite.</li>
          <li>Adaptez les conseils au contexte réel des participants.</li>
        </ol>
      </section>
    </div>

    <section class="hub-card reveal reveal-3" aria-labelledby="suite-titre">
      <h2 id="suite-titre">Et la suite ?</h2>
      <p>
        D'autres jeux et formats sont en préparation. Vous animez des ateliers et un sujet vous manque ?
        Dites-le nous, nos prochaines ressources sont construites à partir des besoins remontés du terrain.
      </p>
      <ul class="cta-row">
        <li><a href="/sensibilisation/jeux/" class="cta-button">Voir tous les jeux</a></li>
        <li><a href="/contact/" class="cta-button cta-secondary">Nous partager un besoin</a></li>
      </ul>
    </section>
  </div>
</SiteLayout>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 8px;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-intro {
    margin: 8px 0 18px;
    color: var(--text-muted);
    max-width: 68ch;
  }

  .section-more {
    margin: 16px 0 0;
  }

  .section-more a {
    color: var(--brand-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .section-more a:hover {
    color: var(--text-main);
  }

  .theme-links-title {
    margin: 22px 0 0;
    font-size: 1rem;
    color: var(--text-muted);
  }

  :global(.hub .cta-row) {
    margin-top: 18px;
  }
</style>
