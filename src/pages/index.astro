---
import { getCollection } from 'astro:content';
import MaintenanceContent from '../components/MaintenanceContent.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { siteSettings } from '../config/site';
import { estimateReadingTimeMinutes } from '../lib/reading-time';
import { getPlanches } from '../lib/bd';
import { ariaCurrent, footerNav, mainNav, navCta } from '../config/nav';
import '../styles/global.css';
import '../styles/home.css';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
const beginnerTag = allTags.find((tag) => tag.toLowerCase().includes('debut') || tag.toLowerCase().includes('début'));
const intermediateTag = allTags.find((tag) => tag.toLowerCase().includes('inter'));
const advancedTag = allTags.find((tag) => tag.toLowerCase().includes('avanc'));
const levelTags = [
  { label: 'Débutant', emoji: '🌱', tag: beginnerTag },
  { label: 'Intermédiaire', emoji: '🧭', tag: intermediateTag },
  { label: 'Avancé', emoji: '⚡', tag: advancedTag },
].filter((level) => level.tag);

const planches = await getPlanches();

const spaces = [
  {
    href: '/blog',
    icon: '📖',
    tone: 'green',
    name: 'Articles et guides',
    what: 'Des guides pas à pas pour savoir quoi faire (mots de passe, double authentification, protection des proches) et des articles pour découvrir : lectures, podcasts, vie de l’association.',
    meta: `${posts.length} articles, classés par niveau`,
    cta: 'Lire les articles',
  },
  {
    href: '/bd',
    icon: '💬',
    tone: 'blue',
    name: 'Les BD d’Octet',
    what: 'Une planche de bande dessinée par semaine pour comprendre un sujet du numérique d’un coup d’œil. Chaque planche est aussi transcrite en texte.',
    meta: `${planches.length} planches à lire`,
    cta: 'Lire les BD',
  },
  {
    href: '/veille',
    icon: '🚨',
    tone: 'orange',
    name: 'Alertes arnaques',
    what: 'Les arnaques et fuites de données qui circulent en ce moment, expliquées simplement, avec les bons réflexes et les numéros officiels.',
    meta: 'Mis à jour en continu',
    cta: 'Voir les alertes',
  },
  {
    href: '/sensibilisation',
    icon: '🎮',
    tone: 'green',
    name: 'Jeux',
    what: 'Des jeux gratuits pour apprendre à repérer les pièges du numérique en s’amusant, seul, en famille ou en groupe.',
    meta: 'Tout public, tout âge',
    cta: 'Jouer',
  },
  {
    href: '/asso',
    icon: '🐒',
    tone: 'orange',
    name: 'L’association',
    what: 'Qui nous sommes et comment nous fonctionnons. Pas d’ateliers pour le moment : nous sommes ouverts à tous en ligne, ou sur rendez-vous pour parler d’un projet.',
    meta: 'En ligne ou sur rendez-vous',
    cta: 'Faire connaissance',
  },
  {
    href: '/adhesion',
    icon: '🤝',
    tone: 'blue',
    name: 'Rejoindre',
    what: 'Adhérer, donner un coup de main ou simplement soutenir l’association. Une question avant ? Écrivez-nous.',
    meta: 'Adhésion et bénévolat',
    cta: 'Nous rejoindre',
  },
];

const startGuides = [...posts]
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured)
      || b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  .slice(0, 3);
const canonicalUrl = new URL('/', siteSettings.siteUrl).toString();
const pageTitle = 'Comprendre le numérique, sans jargon | Le Singe Du Numérique';
const pageDescription =
  'Articles et guides simples, alertes arnaques et jeux pour comprendre le numérique et se protéger. Une association d’inclusion numérique, pour les particuliers et les associations locales.';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteSettings.siteName,
  url: siteSettings.siteUrl,
  logo: `${siteSettings.siteUrl}/logo.svg`,
  telephone: '+33771680601',
  areaServed: 'Fleurieux-sur-l’Arbresle et environs',
  sameAs: [],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.siteName,
  url: siteSettings.siteUrl,
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.siteUrl}/blog?search={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index,follow" />
    <meta property="og:site_name" content={siteSettings.siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={`${siteSettings.siteUrl}/logo.svg`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteSettings.siteUrl}/logo.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@300;500;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  </head>

  <body>
    {
      siteSettings.maintenanceMode ? (
        <MaintenanceContent />
      ) : (
        <>
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>

    <header>
    <nav class="navbar" aria-label="Navigation principale">
      <div class="container nav-container">
        <a href="/" class="brand-logo" aria-label="Le Singe Du Numérique, accueil">
          <img src="/logo.svg" alt="" aria-hidden="true" class="navbar-logo" />
          <span class="brand-text">Le Singe Du Numérique</span>
        </a>

        <div class="nav-right">
          <ul class="nav-links">
{mainNav.map((item) => (
<li><a href={item.href} class="nav-item" aria-current={ariaCurrent(item, currentPath)}>{item.label}</a></li>
))}
          </ul>
          <a href={navCta.href} class="nav-cta" aria-current={ariaCurrent(navCta, currentPath)}>{navCta.label}</a>
          <button
            id="theme-toggle"
            class="theme-btn"
            type="button"
            aria-label="Activer le thème clair"
            aria-pressed="false"
          >
            <span class="icon-light">☀️</span>
            <span class="icon-dark">🌙</span>
          </button>
        </div>

        <button
          class="burger-btn"
          id="burger-btn"
          aria-label="Ouvrir le menu principal"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <div
        class="mobile-menu"
        id="mobile-menu"
        aria-label="Navigation mobile"
        aria-hidden="true"
        inert
        hidden
      >
{[...mainNav, navCta].map((item) => (
<a href={item.href} class="mobile-item" aria-current={ariaCurrent(item, currentPath)}>{item.label}</a>
))}
        <div class="mobile-theme-toggle">
          <span>Changer le thème</span>
          <button
            id="mobile-theme-btn"
            class="theme-btn-small"
            type="button"
            aria-label="Activer le thème clair"
            aria-pressed="false"
          >
            🌙
          </button>
        </div>
      </div>
    </nav>
    </header>

    <main id="main-content">
      <section class="hero-section">
        <div class="glow-bg glow-green"></div>
        <div class="glow-bg glow-orange"></div>

        <div class="container hero-content">
          <div class="hero-logo-wrapper" aria-hidden="true">
            <span class="hero-logo-aura hero-logo-aura-primary"></span>
            <span class="hero-logo-aura hero-logo-aura-secondary"></span>
            <img src="/logo.svg" alt="" class="hero-logo" />
          </div>

          <p class="eyebrow">Association d’inclusion numérique</p>
          <h1 class="hero-title">
            Comprendre le numérique, <span class="gradient-text">sans jargon</span>
          </h1>

          <p class="hero-desc">
            Le Singe Du Numérique est une association d’inclusion numérique. Tout est gratuit et
            pensé pour tous les niveaux. Voici ce que vous trouverez ici.
          </p>

          <h2 class="sr-only" id="spaces-title">Les espaces du site</h2>
          <ul class="space-grid" aria-labelledby="spaces-title">
            {spaces.map((space) => (
              <li class={`space-tile space-${space.tone}`}>
                <span class="space-icon" aria-hidden="true">{space.icon}</span>
                <h3><a href={space.href}>{space.name}</a></h3>
                <p class="space-what">{space.what}</p>
                <p class="space-meta">{space.meta}</p>
                <span class="space-cta" aria-hidden="true">{space.cta} →</span>
              </li>
            ))}
          </ul>

          <form class="search-wrapper" action="/blog" method="get" role="search" aria-label="Recherche dans les articles et guides">
            <label class="search-label" for="home-search">Ou cherchez un sujet précis</label>
            <div class="search-bar">
              <span class="search-icon" aria-hidden="true">
                <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              </span>
              <input
                id="home-search"
                type="search"
                name="search"
                placeholder="Ex. : mot de passe, arnaque, enfants…"
                class="search-input"
                autocomplete="off"
                aria-describedby="home-search-error"
              />
              <button type="submit" class="search-submit">Rechercher</button>
            </div>
            <p id="home-search-error" class="search-error" hidden aria-live="polite"></p>
          </form>

          {levelTags.length > 0 && (
            <div class="quick-actions">
              <span class="quick-label">Par niveau&nbsp;:</span>
              {levelTags.map((level) => (
                <a href={`/blog?tag=${encodeURIComponent(level.tag)}`} class="quick-tag">
                  <span aria-hidden="true">{level.emoji}</span> {level.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </section>

      <section class="content-section" aria-labelledby="start-title">
        <div class="container">
          <div class="section-header">
            <h2 id="start-title">Par où <span class="text-accent">commencer</span></h2>
            <div class="line-deco"></div>
            <a href="/blog" class="section-more">Tous les articles <span aria-hidden="true">→</span></a>
          </div>

          <ul class="guide-grid">
            {startGuides.map((post) => (
              <li class="guide-card">
                <p class="guide-meta">
                  <span>{post.data.tags[0] ?? post.data.rubrique}</span>
                  <span>{estimateReadingTimeMinutes(post.body)} min de lecture</span>
                </p>
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <p class="guide-desc">{post.data.description}</p>
                <span class="guide-cta" aria-hidden="true">Lire l’article →</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <section class="content-section">
      <div class="container">
        <ShareButtons title="Le Singe Du Numérique" label="Partager le site" />
      </div>
    </section>

    <footer class="footer">
      <div class="container footer-container">
        <div class="footer-main">
          <div class="footer-brand">
            <img src="/logo.svg" alt="" aria-hidden="true" class="footer-logo" />
            <span>Le Singe Du Numérique</span>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Menu</h2>
            <ul class="footer-line-content footer-links">
{footerNav.map((item) => (
<li><a href={item.href}>{item.label}</a></li>
))}
            </ul>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Statut</h2>
            <ul class="footer-line-content footer-status">
              <li>
                <a
                  id="service-status-link"
                  class="service-status"
                  href="https://le-singe-du-numerique.betteruptime.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-live="polite"
                >
                  <span id="service-status-dot" class="status-dot status-checking" aria-hidden="true"></span>
                  <span id="service-status-text">Statut : vérification...</span>
                </a>
              </li>
              <li><a href="/accessibilite">Accessibilité : non conforme</a></li>
              <li><a href="/contact">Aide : Contact</a></li>
              <li>Numéro d’association : W692012226</li>
            </ul>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Crédit</h2>
            <div class="footer-line-content">
              <span class="footer-credit">Fait avec ❤️ entre père et fils - Stan et Mikaël BOUCHET</span>
            </div>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Réseaux</h2>
            <ul class="footer-line-content footer-socials">
              <li>
                <a href="https://www.linkedin.com/in/stanislas-bouchet/" target="_blank" rel="noopener noreferrer">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 7.06c1.08 0 1.75-.72 1.75-1.62-.02-.92-.67-1.62-1.73-1.62S3.5 4.52 3.5 5.44c0 .9.69 1.62 1.73 1.62h.02ZM20.5 20h-3.38v-6.15c0-1.54-.55-2.59-1.92-2.59-1.05 0-1.67.7-1.95 1.38-.1.24-.13.58-.13.92V20H9.74s.04-10.57 0-11.5h3.38v1.63c.45-.69 1.26-1.67 3.06-1.67 2.23 0 3.9 1.46 3.9 4.59V20Z"/></svg>
                  <span>LinkedIn Stan</span>
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/in/mikael-bch/" target="_blank" rel="noopener noreferrer">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 7.06c1.08 0 1.75-.72 1.75-1.62-.02-.92-.67-1.62-1.73-1.62S3.5 4.52 3.5 5.44c0 .9.69 1.62 1.73 1.62h.02ZM20.5 20h-3.38v-6.15c0-1.54-.55-2.59-1.92-2.59-1.05 0-1.67.7-1.95 1.38-.1.24-.13.58-.13.92V20H9.74s.04-10.57 0-11.5h3.38v1.63c.45-.69 1.26-1.67 3.06-1.67 2.23 0 3.9 1.46 3.9 4.59V20Z"/></svg>
                  <span>LinkedIn Mikaël</span>
                </a>
              </li>
              <li>
                <a href="https://github.com/Stan69000/lesingedunumerique" target="_blank" rel="noopener noreferrer" aria-label="GitHub Stan (ouvre un nouvel onglet)">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.38 7.86 10.9.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.87-1.35-3.87-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.27-5.23-5.67 0-1.25.45-2.27 1.17-3.07-.12-.29-.5-1.47.11-3.05 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.13-1.17 3.13-1.17.62 1.58.24 2.76.12 3.05.73.8 1.17 1.82 1.17 3.07 0 4.41-2.69 5.37-5.25 5.66.41.36.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
                  <span>GitHub Stan</span>
                </a>
              </li>
              <li>
                <a href="https://github.com/NaraDev0" target="_blank" rel="noopener noreferrer" aria-label="GitHub Mikaël (ouvre un nouvel onglet)">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.38 7.86 10.9.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.87-1.35-3.87-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.27-5.23-5.67 0-1.25.45-2.27 1.17-3.07-.12-.29-.5-1.47.11-3.05 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.13-1.17 3.13-1.17.62 1.58.24 2.76.12 3.05.73.8 1.17 1.82 1.17 3.07 0 4.41-2.69 5.37-5.25 5.66.41.36.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
                  <span>GitHub Mikaël</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <button
      id="back-to-top"
      class="back-to-top"
      aria-label="Revenir en haut de la page"
    >
      <span class="sr-only">Revenir en haut de la page</span>
      <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"></path></svg>
    </button>

    <script>
      const MIN_SAFE_ANIMATION_MS = 400;

      function parseAnimationTimeToMs(rawValue) {
        const value = (rawValue || '').trim();
        if (!value || value === '0' || value === '0s' || value === '0ms') return 0;
        if (value.endsWith('ms')) return Number.parseFloat(value);
        if (value.endsWith('s')) return Number.parseFloat(value) * 1000;
        return Number.parseFloat(value) || 0;
      }

      function toMsString(valueMs) {
        return `${Math.max(MIN_SAFE_ANIMATION_MS, Math.round(valueMs))}ms`;
      }

      function enforceMinimumAnimationDuration() {
        const allNodes = Array.from(document.querySelectorAll('*'));
        allNodes.forEach((node) => {
          const computed = window.getComputedStyle(node);
          if (computed.animationName === 'none') return;

          const durations = computed.animationDuration
            .split(',')
            .map((entry) => entry.trim())
            .filter(Boolean);

          if (durations.length === 0) return;

          const hasTooFastAnimation = durations.some(
            (duration) => parseAnimationTimeToMs(duration) > 0
              && parseAnimationTimeToMs(duration) < MIN_SAFE_ANIMATION_MS,
          );

          if (!hasTooFastAnimation) return;

          const clampedDurations = durations.map((duration) => {
            const valueMs = parseAnimationTimeToMs(duration);
            if (valueMs <= 0) return duration;
            return toMsString(valueMs);
          });

          node.style.animationDuration = clampedDurations.join(', ');
        });
      }

      window.addEventListener('load', enforceMinimumAnimationDuration);

      const themeBtn = document.getElementById('theme-toggle');
      const mobileThemeBtn = document.getElementById('mobile-theme-btn');
      const body = document.body;
      let lastFocusedElement = null;

      function syncThemeControls() {
        const isLight = body.classList.contains('light-mode');
        const icon = isLight ? '☀️' : '🌙';
        const actionLabel = isLight ? 'Activer le thème sombre' : 'Activer le thème clair';

        if (themeBtn) {
          themeBtn.innerHTML = isLight
            ? '<span class="icon-light">☀️</span>'
            : '<span class="icon-dark">🌙</span>';
          themeBtn.setAttribute('aria-label', actionLabel);
          themeBtn.setAttribute('aria-pressed', String(isLight));
        }

        if (mobileThemeBtn) {
          mobileThemeBtn.textContent = icon;
          mobileThemeBtn.setAttribute('aria-label', actionLabel);
          mobileThemeBtn.setAttribute('aria-pressed', String(isLight));
        }
      }

      if (localStorage.getItem('theme') === 'light') {
        body.classList.add('light-mode');
      }

      syncThemeControls();

      function toggleTheme() {
        body.classList.toggle('light-mode');
        const isLight = body.classList.contains('light-mode');
        syncThemeControls();
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      }

      if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
      if (mobileThemeBtn) mobileThemeBtn.addEventListener('click', toggleTheme);

      const burgerBtn = document.getElementById('burger-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (burgerBtn && mobileMenu) {
        const mobileFocusableSelector =
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

        const getMenuFocusableElements = () =>
          Array.from(mobileMenu.querySelectorAll(mobileFocusableSelector)).filter(
            (element) => !element.hasAttribute('hidden'),
          );

        const setMenuState = (isOpen) => {
          mobileMenu.classList.toggle('active', isOpen);
          burgerBtn.classList.toggle('active', isOpen);
          burgerBtn.setAttribute('aria-expanded', String(isOpen));
          burgerBtn.setAttribute(
            'aria-label',
            isOpen ? 'Fermer le menu principal' : 'Ouvrir le menu principal',
          );
          mobileMenu.hidden = !isOpen;
          mobileMenu.setAttribute('aria-hidden', String(!isOpen));
          if (isOpen) {
            mobileMenu.removeAttribute('inert');
          } else {
            mobileMenu.setAttribute('inert', '');
          }
          document.body.style.overflow = isOpen ? 'hidden' : '';

          const navRight = document.querySelector('.nav-right');
          const mainContent = document.getElementById('main-content');
          const footer = document.querySelector('.footer');

          [navRight, mainContent, footer].forEach((element) => {
            if (!element) return;
            if (isOpen) {
              element.setAttribute('inert', '');
            } else {
              element.removeAttribute('inert');
            }
          });

          if (isOpen) {
            lastFocusedElement = document.activeElement;
            window.setTimeout(() => {
              getMenuFocusableElements()[0]?.focus();
            }, 0);
          } else if (lastFocusedElement instanceof HTMLElement) {
            lastFocusedElement.focus();
            lastFocusedElement = null;
          }
        };

        setMenuState(false);

        burgerBtn.addEventListener('click', () => {
          const isOpen = burgerBtn.getAttribute('aria-expanded') !== 'true';
          setMenuState(isOpen);
        });

        document.querySelectorAll('.mobile-item').forEach((item) => {
          item.addEventListener('click', () => {
            setMenuState(false);
          });
        });

        document.addEventListener('keydown', (event) => {
          const menuIsOpen = burgerBtn.getAttribute('aria-expanded') === 'true';

          if (event.key === 'Escape' && menuIsOpen) {
            setMenuState(false);
            return;
          }

          if (event.key === 'Tab' && menuIsOpen) {
            const focusableElements = getMenuFocusableElements();
            if (focusableElements.length === 0) return;

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];
            const activeElement = document.activeElement;

            if (event.shiftKey && activeElement === firstElement) {
              event.preventDefault();
              lastElement.focus();
            } else if (!event.shiftKey && activeElement === lastElement) {
              event.preventDefault();
              firstElement.focus();
            }
          }
        });
      }

      const serviceStatusDot = document.getElementById('service-status-dot');
      const serviceStatusText = document.getElementById('service-status-text');

      function setServiceStatus(state) {
        if (!serviceStatusDot || !serviceStatusText) return;

        serviceStatusDot.classList.remove('status-checking', 'status-ok', 'status-ko', 'status-local');

        if (state === 'ok') {
          serviceStatusDot.classList.add('status-ok');
          serviceStatusText.textContent = 'Statut : opérationnel';
          return;
        }

        if (state === 'ko') {
          serviceStatusDot.classList.add('status-ko');
          serviceStatusText.textContent = 'Statut : incident détecté';
          return;
        }

        if (state === 'local') {
          serviceStatusDot.classList.add('status-local');
          serviceStatusText.textContent = 'Statut : vérif en production';
          return;
        }

        serviceStatusDot.classList.add('status-checking');
        serviceStatusText.textContent = 'Statut : vérification...';
      }

      async function refreshServiceStatus() {
        if (
          location.hostname === 'localhost'
          || location.hostname === '127.0.0.1'
          || location.hostname.endsWith('.local')
        ) {
          setServiceStatus('local');
          return;
        }

        setServiceStatus('checking');
        try {
          const response = await fetch('/contact-health.php', {
            method: 'GET',
            cache: 'no-store',
            credentials: 'same-origin',
          });
          const body = (await response.text()).trim();
          if (response.ok && body === 'OK') {
            setServiceStatus('ok');
            return;
          }
        } catch (error) {}
        setServiceStatus('ko');
      }

      if (serviceStatusDot && serviceStatusText) {
        refreshServiceStatus();
      }

      const homeSearchForm = document.querySelector('form.search-wrapper[role="search"]');
      const homeSearchInput = document.getElementById('home-search');
      const homeSearchError = document.getElementById('home-search-error');

      function clearHomeSearchError() {
        if (!homeSearchInput || !homeSearchError) return;
        homeSearchInput.removeAttribute('aria-invalid');
        homeSearchError.hidden = true;
        homeSearchError.textContent = '';
      }

      homeSearchInput?.addEventListener('input', clearHomeSearchError);

      homeSearchForm?.addEventListener('submit', (event) => {
        if (!homeSearchInput || !homeSearchError) return;
        const query = homeSearchInput.value.trim();

        if (query.length === 0) {
          clearHomeSearchError();
          return;
        }

        if (query.length < 2) {
          event.preventDefault();
          homeSearchInput.setAttribute('aria-invalid', 'true');
          homeSearchError.hidden = false;
          homeSearchError.textContent = 'Recherche trop courte. Essaie avec au moins 2 caractères.';
          homeSearchInput.focus();
          return;
        }

        clearHomeSearchError();
      });

      const backBtn = document.getElementById('back-to-top');
      const syncBackToTopVisibility = () => {
        if (!(backBtn instanceof HTMLButtonElement)) return;
        const shouldShow = window.scrollY > 400;
        backBtn.classList.toggle('visible', shouldShow);
      };

      syncBackToTopVisibility();
      window.addEventListener('scroll', () => {
        syncBackToTopVisibility();
      });
      backBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
        </>
      )
    }
  </body>
</html>
