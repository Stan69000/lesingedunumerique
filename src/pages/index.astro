---
import AudienceBeacon from '../components/AudienceBeacon.astro';
import SearchDiscovery from '../components/SearchDiscovery.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CommandPalette from '../components/CommandPalette.astro';
import BackToTop from '../components/BackToTop.astro';
import AssociationProjects from '../components/AssociationProjects.astro';
import FooterProjects from '../components/FooterProjects.astro';
import { getCollection } from 'astro:content';
import MaintenanceContent from '../components/MaintenanceContent.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { siteSettings } from '../config/site';
import { estimateReadingTimeMinutes } from '../lib/reading-time';
import { getPlanches, planchePath } from '../lib/bd';
import { getPublishedBriefs } from '../lib/briefs';
import aLaUne from '../data/a-la-une.json';
import { lexique } from '../lib/lexique';
import { footerNav } from '../config/nav';
import '../styles/global.css';
import '../styles/home.css';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

const latestBrief = (await getPublishedBriefs()).find((brief) => !brief.data.demo);
const planches = await getPlanches();
const latestBd = [...planches].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestPost = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const formatNewsDate = (date: Date) => date.toLocaleDateString('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
});

const spaces = [
  {
    href: '/lexique', icon: '🐒', tone: 'green', name: 'Le lexique d’Octet',
    what: 'Un SMS douteux, des photos dans le cloud, une appli trop curieuse… Des mots expliqués à partir de votre quotidien, avec le réflexe d’Octet pour savoir quoi faire.',
    meta: `${lexique.length} mots, des exemples et des réflexes utiles`, cta: 'Comprendre un mot',
  },
  {
    href: '/blog',
    icon: '📖',
    tone: 'green',
    name: 'Articles et guides',
    what: 'Des guides pas à pas pour savoir quoi faire (mots de passe, double authentification, protection des proches) et des articles pour découvrir : lectures, podcasts, vie de l’association.',
    meta: `${posts.length} articles, classés par niveau`,
    cta: 'Lire les articles',
  },
  {
    href: '/bd',
    icon: '💬',
    tone: 'blue',
    name: 'Les BD d’Octet',
    badge: 'Une nouvelle BD chaque lundi',
    what: 'Chaque lundi, retrouvez Octet dans une nouvelle planche pour comprendre le numérique d’un coup d’œil. Chaque BD est aussi transcrite en texte.',
    meta: `${planches.length} planches à lire`,
    cta: 'Lire les BD',
  },
  {
    href: '/veille',
    icon: '🚨',
    tone: 'orange',
    name: 'Alertes arnaques',
    what: 'Les arnaques et fuites de données qui circulent en ce moment, expliquées simplement, avec les bons réflexes et les numéros officiels.',
    meta: 'Mis à jour en continu',
    cta: 'Voir les alertes',
  },
  {
    href: '/sensibilisation',
    icon: '🎮',
    tone: 'green',
    name: 'Jeux',
    what: 'Des jeux gratuits pour apprendre à repérer les pièges du numérique en s’amusant, seul, en famille ou en groupe.',
    meta: 'Tout public, tout âge',
    cta: 'Jouer',
  },
  {
    href: '/asso',
    icon: '🐒',
    tone: 'orange',
    name: 'L’association',
    what: 'Qui nous sommes et comment nous fonctionnons. Pas d’ateliers pour le moment : nous sommes ouverts à tous en ligne, ou sur rendez-vous pour parler d’un projet.',
    meta: 'En ligne ou sur rendez-vous',
    cta: 'Faire connaissance',
  },
  {
    href: '/adhesion',
    icon: '🤝',
    tone: 'blue',
    name: 'Rejoindre',
    what: 'Les adhésions ne sont pas encore ouvertes, mais vous pouvez déjà aider : faire passer le mot, nous signaler un sujet ou donner un coup de main.',
    meta: 'Coups de main bienvenus',
    cta: 'Voir comment aider',
  },
];

const startGuides = [...posts]
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured)
      || b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  .slice(0, 3);
const canonicalUrl = new URL('/', siteSettings.siteUrl).toString();
const pageTitle = 'Comprendre le numérique, sans jargon | Le Singe Du Numérique';
const pageDescription =
  'Articles et guides simples, alertes arnaques et jeux pour comprendre le numérique et se protéger. Une association d’inclusion numérique, pour les particuliers et les associations locales.';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteSettings.siteName,
  url: siteSettings.siteUrl,
  logo: `${siteSettings.siteUrl}/logo.svg`,
  telephone: '+33771680601',
  areaServed: 'Fleurieux-sur-l’Arbresle et environs',
  sameAs: [],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.siteName,
  url: siteSettings.siteUrl,
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.siteUrl}/blog?search={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index,follow" />
    <meta property="og:site_name" content={siteSettings.siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={`${siteSettings.siteUrl}/partage.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteSettings.siteUrl}/partage.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@300;500;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <AudienceBeacon />
  </head>

  <body>
    {
      siteSettings.maintenanceMode ? (
        <MaintenanceContent />
      ) : (
        <>
    <CommandPalette />
<a class="skip-link" href="#main-content">Aller au contenu principal</a>

    <SiteHeader />

    <main id="main-content">
      <section class="hero-section">
        <div class="glow-bg glow-green"></div>
        <div class="glow-bg glow-orange"></div>

        <div class="container hero-content">
          <div class="hero-logo-wrapper" aria-hidden="true">
            <span class="hero-logo-aura hero-logo-aura-primary"></span>
            <span class="hero-logo-aura hero-logo-aura-secondary"></span>
            <img src="/logo.svg" alt="" class="hero-logo" />
          </div>

          <p class="eyebrow">Association d’inclusion numérique</p>
          <h1 class="hero-title">
            Comprendre le numérique, <span class="gradient-text">sans jargon</span>
          </h1>

          <p class="hero-desc">
            Le Singe Du Numérique est une association d’inclusion numérique. Tout est gratuit et
            pensé pour tous les niveaux. Voici ce que vous trouverez ici.
          </p>

          <SearchDiscovery />

          {(latestBd || latestPost || latestBrief) && (
            <section class="home-news" aria-labelledby="home-news-title">
              <div class="home-news-heading">
                <h2 id="home-news-title">À découvrir en ce moment</h2>
                <span>Les dernières publications</span>
              </div>
              <div class="home-news-grid">
                {latestBd && (
                  <article class="home-news-item home-news-bd">
                    <img class="home-news-image" src={latestBd.data.planche} alt="" width={latestBd.data.plancheWidth} height={latestBd.data.plancheHeight} decoding="async" />
                    <div class="home-news-body">
                      <p class="home-news-label">La BD du lundi</p>
                      <h3><a href={planchePath(latestBd)}>{latestBd.data.title}</a></h3>
                      <p class="home-news-meta"><time datetime={latestBd.data.pubDate.toISOString()}>{formatNewsDate(latestBd.data.pubDate)}</time></p>
                      <span class="home-news-cta" aria-hidden="true">Lire la dernière BD →</span>
                    </div>
                  </article>
                )}
                {latestPost && (
                  <article class="home-news-item home-news-post">
                    <span class="home-news-icon" aria-hidden="true">📖</span>
                    <div class="home-news-body">
                      <p class="home-news-label">Le dernier article</p>
                      <h3><a href={`/blog/${latestPost.id}/`}>{latestPost.data.title}</a></h3>
                      <p class="home-news-meta"><time datetime={latestPost.data.pubDate.toISOString()}>{formatNewsDate(latestPost.data.pubDate)}</time> · {estimateReadingTimeMinutes(latestPost.body)} min de lecture</p>
                      <span class="home-news-cta" aria-hidden="true">Lire l’article →</span>
                    </div>
                  </article>
                )}
                {latestBrief && (
                  <article class="home-news-item home-news-brief">
                    <span class="home-news-icon" aria-hidden="true">🐒</span>
                    <div class="home-news-body">
                      <p class="home-news-label">Le décryptage d’Octet</p>
                      <h3><a href={`/veille/briefs/${latestBrief.id}/`}>{latestBrief.data.title}</a></h3>
                      <p class="home-news-meta"><time datetime={latestBrief.data.pubDate.toISOString()}>{formatNewsDate(latestBrief.data.pubDate)}</time>{latestBrief.data.type === 'weekly' && ' · Le rendez-vous du dimanche'}</p>
                      <span class="home-news-cta" aria-hidden="true">Lire le décryptage →</span>
                    </div>
                  </article>
                )}
              </div>
            </section>
          )}

          <h2 class="sr-only" id="spaces-title">Les espaces du site</h2>
          <ul class="space-grid" aria-labelledby="spaces-title">
            {spaces.map((space) => (
              <li class={`space-tile space-${space.tone}`}>
                <div class="space-tile-heading">
                  <span class="space-icon" aria-hidden="true">{space.icon}</span>
                  {space.badge && <span class="space-badge">{space.badge}</span>}
                </div>
                <h3><a href={space.href}>{space.name}</a></h3>
                <p class="space-what">{space.what}</p>
                <p class="space-meta">{space.meta}</p>
                <span class="space-cta" aria-hidden="true">{space.cta} →</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="content-section home-projects">
        <div class="container"><AssociationProjects /></div>
      </section>

      {aLaUne.actif && (
        <section class="content-section spotlight-section" aria-labelledby="spotlight-title">
          <div class="container">
            <div class="spotlight">
              <img
                class="spotlight-image"
                src={aLaUne.image.src}
                alt={aLaUne.image.alt}
                width={aLaUne.image.width}
                height={aLaUne.image.height}
                loading="lazy"
                decoding="async"
              />
              <div class="spotlight-body">
                <p class="eyebrow">À la une · {aLaUne.surtitre}</p>
                <h2 id="spotlight-title">{aLaUne.titre}</h2>
                <p class="spotlight-hook">{aLaUne.accroche}</p>
                <p class="spotlight-text">{aLaUne.texte}</p>
                {aLaUne.points.length > 0 && (
                  <ul class="spotlight-points">
                    {aLaUne.points.map((point) => <li>{point}</li>)}
                  </ul>
                )}
                <div class="spotlight-actions">
                  <a href={aLaUne.lien.href} class="spotlight-primary">{aLaUne.lien.label} <span aria-hidden="true">→</span></a>
                  {aLaUne.lienSecondaire && (
                    <a href={aLaUne.lienSecondaire.href} class="spotlight-secondary">{aLaUne.lienSecondaire.label}</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="content-section" aria-labelledby="start-title">
        <div class="container">
          <div class="section-header">
            <h2 id="start-title">Par où <span class="text-accent">commencer</span></h2>
            <div class="line-deco"></div>
            <a href="/blog" class="section-more">Tous les articles <span aria-hidden="true">→</span></a>
          </div>

          <ul class="guide-grid">
            {startGuides.map((post) => (
              <li class="guide-card">
                <p class="guide-meta">
                  <span>{post.data.tags[0] ?? post.data.rubrique}</span>
                  <span>{estimateReadingTimeMinutes(post.body)} min de lecture</span>
                </p>
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <p class="guide-desc">{post.data.description}</p>
                <span class="guide-cta" aria-hidden="true">Lire l’article →</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <section class="content-section">
      <div class="container">
        <ShareButtons title="Le Singe Du Numérique" label="Partager le site" />
      </div>
    </section>

    <footer class="footer">
      <div class="container footer-container">
        <div class="footer-main">
          <div class="footer-brand">
            <img src="/logo.svg" alt="" aria-hidden="true" class="footer-logo" />
            <span>Le Singe Du Numérique</span>
          </div>
          <FooterProjects />
                <div class="footer-line">
            <h2 class="footer-line-label">Menu</h2>
            <ul class="footer-line-content footer-links">
{footerNav.map((item) => (
<li><a href={item.href}>{item.label}</a></li>
))}
            </ul>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Statut</h2>
            <ul class="footer-line-content footer-status">
              <li>
                <a
                  id="service-status-link"
                  class="service-status"
                  href="https://le-singe-du-numerique.betteruptime.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-live="polite"
                >
                  <span id="service-status-dot" class="status-dot status-checking" aria-hidden="true"></span>
                  <span id="service-status-text">Statut : vérification...</span>
                </a>
              </li>
              <li><a href="/accessibilite">Accessibilité : non conforme</a></li>
              <li><a href="/contact">Aide : Contact</a></li>
              <li>Numéro d’association : W692012226</li>
            </ul>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Crédit</h2>
            <div class="footer-line-content">
              <span class="footer-credit">Fait avec ❤️ entre père et fils - Stan et Mikaël BOUCHET</span>
            </div>
          </div>
          <div class="footer-line">
            <h2 class="footer-line-label">Réseaux</h2>
            <ul class="footer-line-content footer-socials">
              <li>
                <a href="https://www.linkedin.com/in/stanislas-bouchet/" target="_blank" rel="noopener noreferrer">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 7.06c1.08 0 1.75-.72 1.75-1.62-.02-.92-.67-1.62-1.73-1.62S3.5 4.52 3.5 5.44c0 .9.69 1.62 1.73 1.62h.02ZM20.5 20h-3.38v-6.15c0-1.54-.55-2.59-1.92-2.59-1.05 0-1.67.7-1.95 1.38-.1.24-.13.58-.13.92V20H9.74s.04-10.57 0-11.5h3.38v1.63c.45-.69 1.26-1.67 3.06-1.67 2.23 0 3.9 1.46 3.9 4.59V20Z"/></svg>
                  <span>LinkedIn Stan</span>
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/in/mikael-bch/" target="_blank" rel="noopener noreferrer">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 7.06c1.08 0 1.75-.72 1.75-1.62-.02-.92-.67-1.62-1.73-1.62S3.5 4.52 3.5 5.44c0 .9.69 1.62 1.73 1.62h.02ZM20.5 20h-3.38v-6.15c0-1.54-.55-2.59-1.92-2.59-1.05 0-1.67.7-1.95 1.38-.1.24-.13.58-.13.92V20H9.74s.04-10.57 0-11.5h3.38v1.63c.45-.69 1.26-1.67 3.06-1.67 2.23 0 3.9 1.46 3.9 4.59V20Z"/></svg>
