---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { associationProjects } from '../../config/projects';
import { getFiches } from '../../lib/atelier';
const tools = associationProjects;
// Visible en développement dès le premier brouillon, en production dès la première fiche publiée.
const atelierOuvert = (await getFiches()).length > 0;
---
<SiteLayout title="Nos outils gratuits et ressources numériques | Le Singe Du Numérique" description="Découvrez la Boussole d’Octet pour la visibilité de votre site, RGAA Audit pour son accessibilité et Le Signal Clair pour suivre l’actualité numérique." eyebrow="Comprendre et agir" headline="Nos outils," accent="à votre portée" intro="Vous souhaitez comprendre l’actualité numérique ou améliorer un site ? Retrouvez nos projets pour vous informer, rendre vos pages plus accessibles et améliorer leur visibilité.">
  <section class="tools-grid" aria-label="Choisir un outil">
    {tools.map(tool => <article><span aria-hidden="true">{tool.icon}</span><h2>{tool.name}</h2><p><strong>{tool.promise}</strong></p><p>{tool.description}</p><p>{tool.note}</p><a href={tool.href}>{tool.cta} →</a></article>)}
  </section>
  {atelierOuvert && <section class="atelier-card" aria-labelledby="atelier-titre"><span aria-hidden="true">🛠️</span><div><h2 id="atelier-titre">L’atelier d’Octet</h2><p><strong>Automatiser les tâches répétitives de votre association</strong></p><p>Des fiches Google Apps Script expliquées pas à pas : ce qu’un script a le droit de faire, comment l’installer et comment l’arrêter.</p><a href="/outils/atelier/">Ouvrir l’atelier →</a></div></section>}
  <section class="prose-block"><h2>Un point de départ pour progresser</h2><p>Les outils d’audit donnent des pistes à relire et à compléter avec les personnes qui utilisent votre site. Le Signal Clair rassemble l’actualité et ses sources pour approfondir. Chaque projet précise son fonctionnement et ses limites.</p><p>Un mot vous échappe ? <a href="/lexique/">Le lexique d’Octet</a> vous l’explique avec des exemples.</p></section>
</SiteLayout>
<style>
.tools-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:24px;margin-bottom:2rem}.tools-grid article{padding:28px;border:1px solid var(--border-color);border-radius:20px;background:var(--bg-card);display:flex;flex-direction:column;align-items:flex-start}.tools-grid article>span{font-size:2rem}.tools-grid h2{font-size:1.5rem;margin:1rem 0}.tools-grid p{line-height:1.7;color:var(--text-muted)}.tools-grid strong{color:var(--text-main)}.tools-grid a{margin-top:auto;padding-top:1rem;color:var(--brand-green);text-decoration:underline;font-weight:700}.tools-grid a:focus-visible{outline:3px solid var(--brand-green);outline-offset:5px}.atelier-card{display:flex;gap:1.2rem;align-items:flex-start;padding:28px;margin-bottom:2rem;border:1px solid var(--brand-green);border-radius:20px;background:linear-gradient(135deg,color-mix(in srgb,var(--brand-green) 10%,var(--bg-card)),var(--bg-card))}.atelier-card>span{font-size:2rem}.atelier-card h2{font-size:1.5rem;margin:0 0 .6rem}.atelier-card p{line-height:1.7;color:var(--text-muted)}.atelier-card strong{color:var(--text-main)}.atelier-card a{color:var(--brand-green);text-decoration:underline;font-weight:700}.atelier-card a:focus-visible{outline:3px solid var(--brand-green);outline-offset:5px}@media(max-width:640px){.tools-grid{grid-template-columns:1fr}.atelier-card{flex-direction:column}}
</style>
