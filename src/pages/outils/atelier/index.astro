---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getFiches, fichePath, etageres, niveauLabel, statutFiche } from '../../../lib/atelier';

const fiches = await getFiches();
const premiersPas = fiches.filter((f) => f.data.kind === 'premiers-pas');
const recettes = fiches.filter((f) => f.data.kind === 'recette');
// Tant que rien n'est publié, la page existe mais ne s'indexe pas.
const vide = fiches.every((f) => f.data.draft) && !import.meta.env.DEV;
// Seules les étagères qui ont une recette s'affichent : pas de vitrine vide.
const etageresGarnies = etageres
  .map((e) => ({ ...e, recettes: recettes.filter((r) => r.data.etagere === e.id) }))
  .filter((e) => e.recettes.length > 0);
const avecRecettes = etageresGarnies.length > 0;
const bananes = (n: number) => '🍌'.repeat(n);
---
<SiteLayout
  title="L’atelier d’Octet : automatiser les tâches de votre association | Le Singe Du Numérique"
  description={avecRecettes
    ? 'Des recettes Google Apps Script expliquées pas à pas pour les associations, avec les droits qu’elles demandent et les réflexes de sécurité.'
    : 'Premiers pas avec Google Apps Script pour les associations : où se cache l’éditeur, quel compte utiliser et comment lire l’écran d’autorisation sans paniquer.'}
  eyebrow="Comprendre et agir"
  headline="L’atelier"
  accent="d’Octet"
  intro={avecRecettes
    ? 'Les tâches répétitives de votre association peuvent tourner toutes seules. Chaque recette explique ce qu’elle fait, ce qu’elle a le droit de toucher et comment l’arrêter.'
    : 'Les tâches répétitives de votre association peuvent tourner toutes seules. Commencez par les premiers pas : installer un script en sachant ce qu’il a le droit de faire.'}
  noindex={vide}
>
  <div class="atelier">
    <section class="intro-card" aria-labelledby="atelier-quoi">
      <span class="avatar" aria-hidden="true">🐒</span>
      <div>
        <h2 id="atelier-quoi">Le mot d’Octet</h2>
        <p>Google Apps Script, c’est un petit langage caché dans Google Sheets, Forms, Gmail et Drive. Il permet d’automatiser ce que vous faites à la main, sans serveur et sans abonnement : un compte Google suffit.</p>
        <p>Vous n’avez pas besoin de savoir programmer.{avecRecettes && ' Chaque recette se copie, se règle en haut du script, puis s’installe en quelques clics.'} Commencez par les premiers pas : ils vous évitent les deux pièges classiques, l’écran d’autorisation qui fait peur et le script qui s’arrête quand un bénévole s’en va.</p>
      </div>
    </section>

    <section aria-labelledby="premiers-pas">
      <h2 id="premiers-pas" class="section-title">Premiers pas</h2>
      <ol class="steps">
        {premiersPas.map((fiche, i) => (
          <li>
            <a href={fichePath(fiche)}>
              <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-text">
                {statutFiche(fiche) && <span class="draft">{statutFiche(fiche)?.label}</span>}
                <strong>{fiche.data.title}</strong>
                <span>{fiche.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {avecRecettes && (
      <section aria-labelledby="etageres">
        <h2 id="etageres" class="section-title">Les étagères</h2>
        <p class="legend"><span aria-hidden="true">🍌</span> débutant · <span aria-hidden="true">🍌🍌</span> intermédiaire · <span aria-hidden="true">🍌🍌🍌</span> avancé</p>
        <div class="shelves">
          {etageresGarnies.map((e) => (
            <section class="shelf" aria-labelledby={`etagere-${e.id}`}>
              <header>
                <span class="shelf-icon" aria-hidden="true">{e.icone}</span>
                <div><h3 id={`etagere-${e.id}`}>{e.nom}</h3><p>{e.description}</p></div>
              </header>
              <ul class="recipes">
                {e.recettes.map((r) => (
                  <li>
                    <a href={fichePath(r)}>
                      <span class="recipe-title">{r.data.title}</span>
                      <span class="recipe-meta">
                        <span><span aria-hidden="true">{bananes(r.data.niveau)}</span><span class="sr-only">Niveau {niveauLabel(r.data.niveau).toLowerCase()}</span></span>
                        {r.data.duree && <span><span aria-hidden="true">⏱</span> {r.data.duree}</span>}
                        {statutFiche(r) && <span class="draft">{statutFiche(r)?.label}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    )}

    <aside class="warning" aria-labelledby="avant-de-coller">
      <h2 id="avant-de-coller"><span aria-hidden="true">⚠️</span> Avant de coller un script trouvé sur Internet</h2>
      <p>Un script installé agit avec <strong>vos</strong> droits : il peut lire vos mails, vos fichiers et écrire en votre nom. Avant d’en autoriser un, posez-vous trois questions :</p>
      <ul>
        <li><strong>D’où vient-il ?</strong> Un message qui vous presse de « copier ce script et l’autoriser » est un piège classique, même s’il semble venir d’un proche.</li>
        <li><strong>Les droits demandés collent-ils à la tâche ?</strong> Un script qui crée un événement n’a aucune raison de lire tout votre Gmail.</li>
        <li><strong>Le comprenez-vous à peu près ?</strong> Du code illisible ou qui envoie des données vers une adresse inconnue (<code>UrlFetchApp</code>) doit vous arrêter.</li>
      </ul>
      <p>{avecRecettes && 'Toutes nos recettes affichent leur code en entier, avec la liste des droits demandés et la raison de chacun. '}<a href="/outils/atelier/autoriser-un-script-sans-paniquer/">Comprendre l’écran d’autorisation</a></p>
    </aside>

    <section class="prose-block">
      <h2>Et pour la suite ?</h2>
      <p>L’atelier s’enrichit au fil des besoins des associations. Une tâche vous prend du temps chaque semaine ? <a href="/contact/">Racontez-la-nous</a> : elle deviendra peut-être la prochaine recette.</p>
      <p>Un mot vous échappe ? <a href="/lexique/">Le lexique d’Octet</a> l’explique avec des exemples.</p>
    </section>
  </div>
</SiteLayout>

<style>
  .atelier { display: grid; gap: 2.5rem; }
  .intro-card { display: flex; gap: 1.2rem; align-items: flex-start; padding: clamp(1.2rem, 4vw, 2rem); border: 1px solid var(--brand-green); border-radius: 20px; background: linear-gradient(135deg, color-mix(in srgb, var(--brand-green) 10%, var(--bg-card)), var(--bg-card)); }
  .intro-card h2 { margin: 0 0 .6rem; font-size: 1.3rem; }
  .intro-card p { color: var(--text-muted); line-height: 1.75; }
  .avatar { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--bg-card); border: 1px solid var(--border-color); font-size: 1.8rem; }
  .section-title { margin: 0 0 1rem; font-size: clamp(1.4rem, 3vw, 1.8rem); }
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1rem; padding: 0; margin: 0; list-style: none; }
  .steps a { display: flex; gap: 1rem; height: 100%; padding: 1.2rem; border: 1px solid var(--border-color); border-radius: 16px; background: var(--bg-card); color: var(--text-main); text-decoration: none; position: relative; }
  .steps a:hover { border-color: var(--brand-green); }
  .steps a:focus-visible, .recipes a:focus-visible { outline: 3px solid var(--brand-green); outline-offset: 3px; }
  .step-num { font-family: 'JetBrains Mono', monospace; font-size: 1.4rem; font-weight: 500; color: var(--brand-green); }
  .step-text { display: grid; gap: .35rem; }
  .step-text { align-content: start; }
  .step-text > span:not(.draft) { color: var(--text-muted); font-size: .95rem; line-height: 1.5; }
  .legend { color: var(--text-muted); margin: -.4rem 0 1rem; font-size: .95rem; }
  .shelves { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1.2rem; }
  .shelf { display: flex; flex-direction: column; gap: 1rem; padding: 1.3rem; border: 1px solid var(--border-color); border-radius: 18px; background: var(--bg-card); border-bottom: 6px solid color-mix(in srgb, var(--brand-orange) 60%, var(--border-color)); }
  .shelf header { display: flex; gap: .9rem; align-items: flex-start; }
  .shelf-icon { font-size: 1.8rem; line-height: 1; }
  .shelf h3 { margin: 0 0 .3rem; font-size: 1.2rem; }
  .shelf header p { margin: 0; color: var(--text-muted); font-size: .95rem; line-height: 1.5; }
  .recipes { display: grid; gap: .6rem; padding: 0; margin: 0; list-style: none; }
  .recipes a { display: grid; gap: .35rem; padding: .8rem 1rem; border: 1px solid var(--border-color); border-radius: 12px; color: var(--text-main); text-decoration: none; background: color-mix(in srgb, var(--brand-green) 6%, transparent); }
  .recipes a:hover { border-color: var(--brand-green); }
  .recipe-title { font-weight: 700; }
  .recipe-meta { display: flex; flex-wrap: wrap; gap: .8rem; color: var(--text-muted); font-size: .88rem; }
  .draft { padding: .1rem .5rem; border: 1px dashed var(--brand-orange); border-radius: 999px; color: var(--brand-orange); font-size: .78rem; font-weight: 700; align-self: flex-start; }
  .warning { padding: clamp(1.2rem, 4vw, 2rem); border: 1px solid var(--border-color); border-left: 5px solid var(--brand-orange); border-radius: 16px; background: var(--bg-card); }
  .warning h2 { margin: 0 0 .8rem; font-size: 1.3rem; }
  .warning p, .warning li { color: var(--text-muted); line-height: 1.7; }
  .warning strong { color: var(--text-main); }
  .warning a { color: var(--link-color); text-decoration: underline; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) { .intro-card { flex-direction: column; } }
</style>
