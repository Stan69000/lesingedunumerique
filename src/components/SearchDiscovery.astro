<section class="search-discovery" aria-labelledby="discover-search-title">
  <p class="search-intro">🐒 On cherche ensemble ?</p>
  <h2 id="discover-search-title">Un mot, une question, un doute ?</h2>
  <p class="search-description">Articles, BD, jeux, lexique et alertes : explorez toutes nos ressources en une recherche.</p>
  <form data-command-form action="/blog" method="get" role="search" aria-label="Rechercher une ressource sur le site">
    <label class="search-sr" for="home-search">Un sujet ou une situation</label>
    <div class="discovery-field"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg><input id="home-search" name="search" type="search" placeholder="Ex. : un SMS suspect, protéger mes photos…" autocomplete="off"/><button type="submit">Rechercher <span aria-hidden="true">→</span></button></div>
  </form>
  <div class="discovery-examples"><span>Essayez :</span>{[{label:'Un SMS suspect', query:'SMS suspect'}, {label:'Mes mots de passe',query:'mot de passe'}, {label:'Qui est Octet ?',query:'Qui est Octet'}].map(item => <button type="button" data-command-query={item.query} aria-haspopup="dialog" aria-controls="command-palette">{item.label}</button>)}</div>
  <p class="discovery-hint">Retrouvez la recherche en haut de chaque page <span>ou avec <kbd data-command-shortcut>⌘ K</kbd></span>.</p>
</section>
<style>
  .search-discovery { width:100%; max-width:800px; margin:30px auto 36px; padding:26px 28px; text-align:left; border:1px solid var(--brand-green,#2dd4bf); border-radius:20px; background:var(--bg-card,#151e32); box-shadow:0 12px 40px #0000000d; }
  .search-intro { margin:0 0 6px; font-size:.8rem; font-weight:700; color:var(--brand-green,#2dd4bf); } h2 { font-size:clamp(1.25rem,3vw,1.65rem); line-height:1.25; color:var(--text-main,#f1f5f9); margin:0 0 10px; } .search-description { color:var(--text-muted,#94a3b8); font-size:.9rem; margin:0 0 20px; }
  .discovery-field { display:flex; align-items:center; gap:10px; border:1px solid var(--border-color,#334155); border-radius:12px; padding:7px 7px 7px 14px; background:var(--bg-body,#0b1120); } .discovery-field:focus-within { outline:2px solid var(--brand-green,#2dd4bf); outline-offset:3px; } svg { flex-shrink:0; color:var(--brand-green,#2dd4bf); }
  input { min-width:0; width:100%; flex:1; padding:10px 0; border:0; background:transparent; font:inherit; font-size:1rem; color:var(--text-main,#f1f5f9); } input:focus { outline:none; } input::placeholder { color:var(--text-muted,#94a3b8); opacity:1; }
  button { font:inherit; cursor:pointer; } .discovery-field button { flex-shrink:0; padding:12px 16px; border:0; border-radius:8px; background:var(--brand-green,#2dd4bf); color:var(--bg-body,#0b1120); font-weight:700; }
  .discovery-examples { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:14px; font-size:.8rem; color:var(--text-muted,#94a3b8); } .discovery-examples button { padding:6px 10px; border:1px solid var(--border-color,#334155); border-radius:20px; background:transparent; color:var(--text-main,#f1f5f9); } .discovery-examples button:hover { border-color:var(--brand-green,#2dd4bf); }
  button:focus-visible { outline:2px solid var(--brand-green,#2dd4bf); outline-offset:3px; } .discovery-hint { margin:14px 0 0; font-size:.75rem; color:var(--text-muted,#94a3b8); } kbd { font:inherit; padding:2px 4px; border:1px solid var(--border-color,#334155); border-radius:4px; }
  .search-sr { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  @media(max-width:600px) { .search-discovery { padding:20px 16px; margin-top:24px; } .discovery-field { flex-wrap:wrap; } input { flex-basis:calc(100% - 40px); font-size:.9rem; } .discovery-field button { width:100%; } .discovery-hint span { display:none; } }
</style>
