<dialog id="command-palette" aria-labelledby="command-title">
  <div class="command-top"><div><span class="command-eyebrow">LE SINGE DU NUMÉRIQUE</span><h2 id="command-title">Un mot, une question, un doute ?</h2></div><button type="button" class="command-close" aria-label="Fermer la recherche">✕</button></div>
  <label class="command-label" for="command-input">Rechercher dans les ressources et les raccourcis</label>
  <input id="command-input" type="search" autocomplete="off" placeholder="SMS suspect, photos, mot de passe…" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="command-results" />
  <div class="command-filters" role="group" aria-label="Type de résultat">{['Tout', 'Articles', 'BD', 'Lexique', 'Jeux', 'Alertes', 'Rubriques', 'Actions'].map((type) => <button type="button" data-kind={type} aria-pressed={type === 'Tout' ? 'true' : 'false'}>{type}</button>)}</div>
  <div class="command-scroll"><div id="command-suggestions"><p class="command-section">De quoi avez-vous besoin ?</p><div class="command-needs">{['Repérer une arnaque', 'Sécuriser mes comptes', 'Protéger mes photos', 'Accompagner mes enfants'].map(label => <button type="button" data-need={label}>{label} ↗</button>)}</div></div><p id="command-status" role="status" aria-live="polite"></p><ul id="command-results" role="listbox" aria-label="Résultats"></ul></div>
  <footer class="command-footer"><span>↑ ↓ parcourir · Entrée ouvrir · Échap fermer</span><span>🐒 À votre rythme</span></footer>
</dialog>
<script>
  import { initCommandPalette } from '../lib/command-palette';
  initCommandPalette();
</script>
<style>
  dialog { width:min(700px,calc(100% - 24px)); max-height: min(760px,85dvh); padding:0; margin:8dvh auto auto; border:1px solid var(--border-color,#334155); border-radius:20px; background:var(--bg-card,#151e32); color:var(--text-main,#f1f5f9); box-shadow:0 30px 100px #0008; font-family:inherit; }
  dialog[open] { display:flex; flex-direction:column; } dialog::backdrop { background:#020617b8; backdrop-filter:blur(6px); }
  .command-top { display:flex; justify-content:space-between; align-items:start; padding:24px 24px 12px; gap:12px; } .command-eyebrow { font-size:.65rem; letter-spacing:.16em; color:var(--brand-green,#2dd4bf); } h2 { margin:6px 0; font-size:1.3rem; color:inherit; line-height:1.3; }
  button { cursor:pointer; font:inherit; } .command-close { border:0; background:transparent; color:inherit; padding:8px; } .command-label { margin:0 24px 8px; font-size:.8rem; color:var(--text-muted,#94a3b8); }
  input { margin:0 24px; padding:15px; border:1px solid var(--brand-green,#2dd4bf); border-radius:10px; background:var(--bg-body,#0b1120); color:inherit; font:inherit; min-width:0; } :is(button,input):focus-visible { outline:2px solid var(--brand-green,#2dd4bf); outline-offset:3px; }
  .command-filters { display:flex; gap:6px; flex-wrap:wrap; padding:16px 24px; } .command-filters button,.command-needs button { color:inherit; border:1px solid var(--border-color,#334155); background:transparent; border-radius:20px; padding:7px 11px; font-size:.8rem; } .command-filters button[aria-pressed=true] { background:var(--brand-green,#2dd4bf); color:var(--bg-body,#0b1120); }
  .command-scroll { overflow:auto; padding:0 16px 16px; min-height:100px; overscroll-behavior:contain; } .command-section,#command-status { color:var(--text-muted,#94a3b8); font-size:.8rem; margin:8px; } .command-needs { display:flex; flex-wrap:wrap; gap:8px; padding:4px 8px 16px; }
  ul { list-style:none; margin:0; padding:0; } ul :global(li) { padding:12px; border-radius:10px; cursor:pointer; } ul :global(li[aria-selected=true]) { background:var(--bg-body,#0b1120); box-shadow:inset 3px 0 var(--brand-green,#2dd4bf); } ul :global(strong) { display:block; font-size:.95rem; } ul :global(small) { color:var(--brand-green,#2dd4bf); font-size:.7rem; } ul :global(p) { margin:4px 0 0; color:var(--text-muted,#94a3b8); font-size:.8rem; line-height:1.5; }
  .command-footer { padding:12px 24px; border-top:1px solid var(--border-color,#334155); display:flex; justify-content:space-between; gap:12px; font-size:.7rem; color:var(--text-muted,#94a3b8); }
  @media(max-width:600px) { dialog { margin:12px auto; max-height:calc(100dvh - 24px); } .command-top { padding:20px 18px 10px; } .command-footer span:last-child { display:none; } }
</style>
