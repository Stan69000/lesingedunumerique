---
import type { Jeu } from '../lib/jeux';

interface Props {
  jeu: Jeu;
  index?: number;
}

const { jeu, index = 0 } = Astro.props;

// Sans vignette, on retombe sur un dégradé décoratif : la variante tourne avec
// la position pour éviter une grille monotone.
const PREVIEW_VARIANTS = ['preview-a', 'preview-b', 'preview-c', 'preview-d'];
const previewVariant = PREVIEW_VARIANTS[index % PREVIEW_VARIANTS.length];
const revealDelay = `reveal-${Math.min(index + 1, 3)}`;
---

<article class={`game-card reveal ${revealDelay}`} role="listitem">
  {jeu.cover ? (
    <img class="game-cover" src={jeu.cover} alt="" width="800" height="450" loading="lazy" decoding="async" />
  ) : (
    <div class={`game-preview ${previewVariant}`} aria-hidden="true"><span>{jeu.name}</span></div>
  )}

  <div class="game-head">
    <span class="game-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><path d="M8 5h8v2H8zM6 9h12l1 8H5l1-8Zm4 3v3m4-3v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    {jeu.ageRange && <p class="game-badge">{jeu.ageRange}</p>}
  </div>

  <h3>{jeu.name}</h3>
  {jeu.description && <p>{jeu.description}</p>}

  {jeu.tags.length > 0 && (
    <ul class="risk-tags" aria-label={`Thèmes de ${jeu.name}`}>
      {jeu.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}

  <a class="cta-button cta-secondary" href={`/sensibilisation/jeux/${jeu.slug}`}>Jouer à {jeu.name}</a>
</article>

<style>
  :global(.game-card) { display: grid; gap: 12px; align-content: start; transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease; }
  :global(.game-card:hover) { transform: translateY(-4px); border-color: rgba(86, 226, 241, 0.55); box-shadow: 0 14px 34px rgba(2, 7, 20, 0.35); }
  :global(.game-card h3) { margin: 0; }
  :global(.game-cover) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid rgba(134, 171, 219, 0.34); border-radius: 13px; }
  :global(.game-preview) { min-height: 78px; border: 1px solid rgba(134, 171, 219, 0.34); border-radius: 13px; display: flex; align-items: end; padding: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(226, 245, 255, 0.95); }
  :global(.preview-a) { background: linear-gradient(135deg, rgba(59, 198, 173, 0.28), rgba(30, 100, 169, 0.2)), repeating-linear-gradient(90deg, rgba(130, 240, 220, 0.14) 0 8px, rgba(18, 34, 63, 0.08) 8px 16px); }
  :global(.preview-b) { background: linear-gradient(135deg, rgba(110, 199, 255, 0.24), rgba(95, 122, 255, 0.16)), radial-gradient(circle at 80% 30%, rgba(150, 235, 255, 0.2), transparent 45%); }
  :global(.preview-c) { background: linear-gradient(135deg, rgba(160, 133, 255, 0.24), rgba(58, 96, 190, 0.18)), radial-gradient(circle at 20% 70%, rgba(196, 168, 255, 0.22), transparent 50%); }
  :global(.preview-d) { background: linear-gradient(135deg, rgba(255, 176, 122, 0.2), rgba(214, 92, 128, 0.18)), repeating-linear-gradient(45deg, rgba(255, 214, 180, 0.1) 0 10px, rgba(24, 34, 63, 0.08) 10px 20px); }
  :global(.game-head) { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  :global(.game-icon) { width: 38px; height: 38px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(86, 226, 241, 0.35); background: rgba(36, 91, 136, 0.24); color: rgba(187, 245, 253, 0.95); }
  :global(.game-icon svg) { width: 21px; height: 21px; }
  :global(.game-card .game-badge) { margin: 0; border: 1px solid rgba(86, 226, 241, 0.35); border-radius: 999px; padding: 4px 10px; font-size: 0.82rem; font-weight: 600; color: rgba(187, 245, 253, 0.95); background: rgba(36, 91, 136, 0.28); }
  :global(.game-card .risk-tags) { list-style: none; margin: 0 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 7px; }
  :global(.game-card .risk-tags li) { border-radius: 999px; border: 1px solid rgba(119, 145, 184, 0.45); background: rgba(13, 29, 56, 0.66); color: rgba(212, 226, 245, 0.94); font-size: 0.76rem; letter-spacing: 0.02em; text-transform: uppercase; padding: 4px 9px; }
</style>
