---
import { enPhrase, libelles, valeurs, type Jeu } from '../lib/jeux';
import '../styles/jeux.css';

interface Props {
  jeu: Jeu;
  index?: number;
  /** Position dans l'ordre conseillé du catalogue (tri « par défaut »). */
  ordre?: number;
}

const { jeu, index = 0, ordre = index } = Astro.props;

// L'accent tourne avec la position pour éviter une grille monotone, et sert
// aussi de dégradé de repli quand la fiche n'a pas de vignette.
const ACCENTS = ['accent-a', 'accent-b', 'accent-c', 'accent-d'];
const accent = ACCENTS[index % ACCENTS.length];
const revealDelay = `reveal-${Math.min(index + 1, 3)}`;

const publics = libelles(jeu, 'public');
const formats = libelles(jeu, 'format');
const [duree] = libelles(jeu, 'duree');
// Trois thèmes au plus : les thèmes classés, sinon les mots-clés libres.
const themes = (libelles(jeu, 'theme').length ? libelles(jeu, 'theme') : jeu.tags).slice(0, 3);

const RANG_DUREE: Record<string, number> = { court: 1, moyen: 2, long: 3 };

// Texte de recherche : minuscules, sans accents (même normalisation côté script).
const recherche = [jeu.name, jeu.description, jeu.intro, ...jeu.tags, ...publics, ...formats, ...themes]
  .join(' ')
  .normalize('NFD')
  .replace(/\p{Diacritic}/gu, '')
  .toLowerCase();
---

<article
  class={`game-card ${accent} reveal ${revealDelay}`}
  role="listitem"
  data-jeu
  data-public={valeurs(jeu, 'public').join(' ')}
  data-format={valeurs(jeu, 'format').join(' ')}
  data-theme={valeurs(jeu, 'theme').join(' ')}
  data-duree={valeurs(jeu, 'duree').join(' ')}
  data-recherche={recherche}
  data-ordre={ordre}
  data-date={jeu.publishedAt}
  data-rang-duree={RANG_DUREE[jeu.duration ?? ''] ?? 9}
>
  {jeu.cover ? (
    <img class="game-cover" src={jeu.cover} alt="" width="800" height="450" loading="lazy" decoding="async" />
  ) : (
    <p class="game-preview" aria-hidden="true"><span>{jeu.name}</span></p>
  )}

  <div class="game-head">
    <h3>{jeu.name}</h3>
    {(duree || jeu.ageRange) && <p class="game-badge">{duree ?? jeu.ageRange}</p>}
  </div>

  {jeu.description && <p class="game-summary">{jeu.description}</p>}

  {(publics.length > 0 || formats.length > 0) && (
    <dl class="game-meta">
      {publics.length > 0 && (
        <div>
          <dt>Pour</dt>
          <dd>{enPhrase(publics)}</dd>
        </div>
      )}
      {formats.length > 0 && (
        <div>
          <dt>Jouer</dt>
          <dd>{enPhrase(formats)}</dd>
        </div>
      )}
    </dl>
  )}

  {themes.length > 0 && (
    <ul class="risk-tags" aria-label={`Thèmes de ${jeu.name}`}>
      {themes.map((theme) => <li>{theme}</li>)}
    </ul>
  )}

  <a class="cta-button cta-secondary" href={`/sensibilisation/jeux/${jeu.slug}/`}>
    Jouer<span class="sr-only"> à {jeu.name}</span>
  </a>
</article>
