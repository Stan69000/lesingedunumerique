---
import type { CollectionEntry } from 'astro:content';
import { formatBriefDate } from '../lib/briefs';
interface Props { brief: CollectionEntry<'briefs'>; }
const { brief } = Astro.props;
---
<article class="brief-card">
  <p class="eyebrow">🐒 Le décryptage d’Octet · {brief.data.type === 'monthly' ? 'Mensuel' : brief.data.type === 'weekly' ? 'Hebdomadaire' : 'Conseils pratiques'}</p>
  {brief.data.demo && <p class="demo">Démonstration · exemple pédagogique, pas un bilan d’actualité</p>}
  <h2><a href={`/veille/briefs/${brief.id}/`}>{brief.data.title}</a></h2>
  <p>{brief.data.description}</p>
  <ul>{brief.data.scams.map((scam) => <li>{scam.name}</li>)}</ul>
  <p class="date">{brief.data.demo ? 'Exemple créé le' : 'Publié le'} <time datetime={brief.data.pubDate.toISOString()}>{formatBriefDate(brief.data.pubDate)}</time></p>
  <div class="actions">
    <a class="read" href={`/veille/briefs/${brief.id}/`}>Comprendre ces pièges →</a>
    <a href="/veille/briefs/">Tous les décryptages</a>
  </div>
</article>
<style>
  .brief-card { padding: clamp(1.1rem, 4vw, 2rem); margin-bottom: 2rem; border: 1px solid var(--brand-green); border-radius: 18px; background: linear-gradient(135deg, color-mix(in srgb, var(--brand-green) 10%, var(--bg-card)), var(--bg-card)); }
  .eyebrow { color: var(--brand-green); font-weight: 700; }
  .demo { padding: .6rem .8rem; border: 1px dashed var(--border-color); border-radius: 8px; }
  h2 { margin: .8rem 0; line-height: 1.3; }
  h2 a { color: var(--text-main); text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; }
  li { padding: .35rem .7rem; border: 1px solid var(--border-color); border-radius: 999px; }
  .date { color: var(--text-muted); font-size: .9rem; }
  .actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .actions a { color: var(--brand-green); min-height: 44px; display: inline-flex; align-items: center; }
  .actions .read { padding: .6rem 1rem; background: var(--brand-green); color: var(--bg-body); border-radius: 10px; font-weight: 700; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--brand-green); outline-offset: 4px; }
</style>
