---
import SearchTrigger from './SearchTrigger.astro';
import { ariaCurrent, mainNav, navCta } from '../config/nav';
const currentPath = Astro.url.pathname;
---
<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a class="site-header-brand" href="/" aria-label="Le Singe Du Numérique, accueil"><img src="/logo.svg" width="36" height="44" alt="" /></a>
    <nav class="site-header-nav" aria-label="Navigation principale"><ul>{mainNav.map(item => <li><a href={item.href} aria-current={ariaCurrent(item, currentPath)}>{item.label}</a></li>)}</ul></nav>
    <div class="site-header-actions">
      <a class="site-header-join" href={navCta.href} aria-current={ariaCurrent(navCta, currentPath)}>{navCta.label}</a>
      <button class="site-header-theme" id="theme-toggle" type="button" aria-label="Activer le thème clair" aria-pressed="false"><span aria-hidden="true">🌙</span></button>
      <SearchTrigger />
      <button class="site-header-menu" id="burger-btn" type="button" aria-label="Ouvrir le menu principal" aria-expanded="false" aria-controls="mobile-menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span>Menu</span></button>
    </div>
  </div>
  <dialog class="site-header-dialog" id="mobile-menu" aria-labelledby="site-menu-title">
    <div class="site-header-dialog-top"><h2 id="site-menu-title">Explorer le site</h2><button type="button" data-site-menu-close aria-label="Fermer le menu principal">✕</button></div>
    <nav aria-label="Navigation mobile"><ul>{mainNav.map(item => <li><a href={item.href} aria-current={ariaCurrent(item, currentPath)}>{item.label}</a></li>)}<li><a href={navCta.href} class="site-header-join" aria-current={ariaCurrent(navCta, currentPath)}>{navCta.label}</a></li></ul></nav>
    <button class="site-header-mobile-theme" id="mobile-theme-btn" type="button" aria-pressed="false">Activer le thème clair</button>
  </dialog>
</header>
<script>
  import '../lib/site-header';
</script>
<style>
.site-header{--header-bg:#0b1120;--header-text:#cbd5e1;--header-strong:#f1f5f9;--header-accent:#2dd4bf;--header-border:#293548;--header-surface:#151e32;position:relative;z-index:120;width:100%;padding:16px 0;border-bottom:1px solid var(--header-border);background:var(--header-bg);color:var(--header-text);font-family:'Space Grotesk',sans-serif;font-size:14px;line-height:1.4;letter-spacing:normal}
:global(body.light-mode) .site-header{--header-bg:#f8fafc;--header-text:#475569;--header-strong:#0f172a;--header-accent:#0f766e;--header-border:#cbd5e1;--header-surface:#fff}
.site-header *{box-sizing:border-box}.site-header-inner{max-width:1480px;width:100%;margin:0 auto;padding:0 28px;display:flex;align-items:center;gap:24px}.site-header-brand{display:flex;flex:none;align-items:center}.site-header-brand img{display:block;width:36px;height:44px;object-fit:contain}.site-header a{color:inherit;text-decoration:none}.site-header-nav{min-width:0;margin-right:auto}.site-header ul{display:flex;align-items:center;gap:16px;list-style:none;margin:0;padding:0}.site-header-nav a{display:block;padding:12px 0;font-size:14px;font-weight:600;line-height:20px;white-space:nowrap}.site-header-nav a:hover,.site-header a[aria-current=page]{color:var(--header-accent)}.site-header-actions{display:flex;align-items:center;gap:14px;flex:none;margin-left:auto}.site-header button{font-family:inherit;cursor:pointer}.site-header .site-header-join{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 19px;border-radius:999px;background:var(--header-accent);color:var(--header-bg);font-size:14px;line-height:20px;font-weight:700;white-space:nowrap}.site-header-join:hover{filter:brightness(1.08)}.site-header-theme{display:grid;place-items:center;width:44px;height:44px;flex:none;padding:0;border:1px solid var(--header-border);border-radius:50%;background:transparent;color:var(--header-strong);font-size:21px}.site-header-theme:hover{background:var(--header-surface)}.site-header-menu{display:none;align-items:center;gap:9px;min-height:44px;padding:0 14px;background:var(--header-surface);color:var(--header-strong);border:1px solid var(--header-border);border-radius:10px;font-size:14px;font-weight:600}.site-header a:focus-visible,.site-header button:focus-visible{outline:3px solid var(--header-accent);outline-offset:4px}
.site-header-dialog{position:fixed;inset:0 16px auto auto;margin:88px 0 0;width:min(360px,calc(100% - 32px));max-height:calc(100dvh - 108px);padding:22px;border:1px solid var(--header-border);border-radius:18px;background:var(--header-surface);color:var(--header-strong);box-shadow:0 20px 60px #0005;overflow:auto;overscroll-behavior:contain;font:inherit}.site-header-dialog::backdrop{background:#020617a8;backdrop-filter:blur(3px)}.site-header-dialog-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.site-header-dialog h2{margin:0;font:700 18px/1.4 'Space Grotesk',sans-serif;color:inherit}.site-header-dialog-top button{min-width:44px;min-height:44px;border:0;border-radius:8px;background:transparent;color:inherit;font-size:20px}.site-header-dialog ul{display:grid;gap:4px}.site-header-dialog nav a{display:block;padding:12px;border-radius:8px;min-height:44px;font-size:16px;font-weight:600}.site-header-dialog nav a:hover{background:var(--header-bg);color:var(--header-accent)}.site-header-dialog nav .site-header-join{margin-top:10px;background:var(--header-accent);color:var(--header-bg)}.site-header-mobile-theme{display:block;width:100%;min-height:44px;margin-top:18px;padding:10px;border:1px solid var(--header-border);border-radius:10px;background:transparent;color:inherit;font-size:14px}
@media(max-width:1280px){.site-header-inner{gap:18px;padding-inline:22px}.site-header ul{gap:12px}.site-header-actions{gap:10px}}
@media(max-width:1100px){.site-header-nav,.site-header-actions>.site-header-join{display:none}.site-header-menu{display:inline-flex}.site-header-inner{gap:16px}.site-header-actions{gap:10px}}
@media(max-width:600px){.site-header{padding:12px 0}.site-header-inner{padding-inline:16px;gap:12px}.site-header-actions{gap:8px}.site-header-theme{width:40px;height:40px}.site-header-menu{padding-inline:10px}.site-header-dialog{margin-top:80px}}
@media print{.site-header{display:none}}
</style>
