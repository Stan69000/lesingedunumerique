ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Les jeux étaient servis en statique depuis /jeux/*.html avant d'être hébergés
# par la super-admin. On conserve les anciennes URLs indexées.
RewriteRule ^jeux/pixel-safe-v3_1\.html$ /sensibilisation/jeux/pixel-safe/ [L,R=301]
RewriteRule ^jeux/sentinel\.html$ /sensibilisation/jeux/sentinel/ [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://unpkg.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://admin.stan-bouchet.fr https://www.openstreetmap.org https://challenges.cloudflare.com; upgrade-insecure-requests"
</IfModule>

# Configuration du formulaire de contact pour O2Switch/PHP.
# Ce fichier est écrasé à chaque déploiement : renseigner plutôt les valeurs dans
# public/contact-config.local.php sur le serveur (voir contact-config.example.php).
# SetEnv TURNSTILE_SECRET_KEY "votre-secret-turnstile"
# SetEnv CONTACT_RECIPIENT_EMAIL "contact@votre-domaine.fr"
# SetEnv CONTACT_FROM_EMAIL "no-reply@votre-domaine.fr"
# SetEnv CONTACT_HEALTH_TOKEN "genere avec : openssl rand -hex 32"

# Pour un mode maintenance côté Apache sur O2Switch, décommente les lignes ci-dessous.
# RewriteEngine On
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$
# RewriteCond %{REQUEST_URI} !^/contact\.php$
# RewriteCond %{REQUEST_URI} !^/favicon\.ico$
# RewriteCond %{REQUEST_URI} !^/favicon\.svg$
# RewriteRule ^.*$ /maintenance.html [R=302,L]
